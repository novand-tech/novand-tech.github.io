    class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none px-4 py-3 bg-[#141b1f] text-white border border-[#00d2b5] rounded-sm shadow-2xl text-xs font-mono flex items-center gap-2"
  >
    <svg class="w-4 h-4 text-[#00d2b5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
    <span id="toast-message">Copied to clipboard!</span>
  </div>

  <script is:inline>
    // 1. Asset Filtering Logic
    const filterButtons = document.querySelectorAll('.filter-btn');
    const assetCards = document.querySelectorAll('.asset-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Update active filter styling
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[#00d2b5]', 'text-[#0d1417]', 'font-bold');
          b.classList.add('bg-[#141b1f]', 'text-[#f4f2f1]/80');
        });
        btn.classList.remove('bg-[#141b1f]', 'text-[#f4f2f1]/80');
        btn.classList.add('bg-[#00d2b5]', 'text-[#0d1417]', 'font-bold');

        const filter = btn.getAttribute('data-filter');

        assetCards.forEach((card) => {
          if (filter === 'all') {
            card.style.display = 'flex';
          } else {
            const categories = card.getAttribute('data-category') || '';
            if (categories.includes(filter)) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          }
        });
      });
    });

    // 2. Click to Copy Hex Colors with Toast
    const copyButtons = document.querySelectorAll('.copy-hex');
    const toast = document.getElementById('toast-notification');
    const toastMsg = document.getElementById('toast-message');
    let toastTimeout;

    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const hex = btn.getAttribute('data-hex');
        if (!hex) return;
        try {
          await navigator.clipboard.writeText(hex);
          if (toast && toastMsg) {
            toastMsg.textContent = `Copied ${hex} to clipboard!`;
            toast.classList.remove('translate-y-16', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
              toast.classList.add('translate-y-16', 'opacity-0');
            }, 2500);
          }
        } catch (e) {
          console.error('Clipboard copy failed', e);
        }
      });
    });
  </script>
