            type="button"
            id="close-qr-modal"
            class="p-1.5 rounded-full text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors cursor-pointer"
            aria-label="بستن پنجره"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="w-12 h-12 rounded-2xl bg-[#008f7a]/10 dark:bg-[#00d2b5]/15 text-[#008f7a] dark:text-[#00d2b5] flex items-center justify-center mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
        </div>

        <h3 id="qr-modal-title" class="text-base font-bold text-slate-900 dark:text-white mb-1">
          {initialData.ui.qrModalTitle}
        </h3>
        <p id="qr-modal-desc" class="text-xs text-stone-500 dark:text-stone-400 mb-3 px-2">
          {initialData.ui.qrModalDesc}
        </p>

        <!-- QR Code SVG Box -->
        <div class="p-4 bg-white rounded-2xl border border-stone-200 shadow-inner w-56 h-56 flex items-center justify-center mb-3 [&_svg]:w-full [&_svg]:h-full" id="qr-code-container">
          <Fragment set:html={qrSvgMarkup} />
        </div>

        <span class="font-mono text-xs text-stone-500 dark:text-stone-400 bg-stone-100 dark:bg-stone-800/80 px-3 py-1 rounded-full mb-3 select-all">
          novand-tech.com/card
        </span>

        <!-- Download QR Code Actions -->
        <div class="w-full flex items-center gap-2 mb-3">
          <a
            id="modal-download-qr-btn"
            href={qrPngDataUrl}
            download="Novand-Digital-Card-QR.png"
            class="flex-1 py-2.5 px-3 rounded-xl bg-teal-600 hover:bg-teal-700 dark:bg-[#00d2b5] dark:hover:bg-[#00bda3] text-white dark:text-[#0d1417] text-xs font-bold shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
            title={isEn ? "Download high-resolution QR image (PNG)" : "دانلود فایل تصویر باکیفیت کد QR"}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span id="modal-download-qr-text">{initialData.ui.downloadQr} (PNG)</span>
          </a>

          <button
            type="button"
            id="modal-download-svg-btn"
            class="py-2.5 px-3 rounded-xl bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-300 text-xs font-semibold transition-colors flex items-center justify-center gap-1 cursor-pointer"
            title={isEn ? "Download vector SVG" : "دانلود فایل برداری SVG"}
          >
            <span class="font-mono text-[11px] font-bold">SVG</span>
          </button>
        </div>

        <!-- Secondary Modal Actions (Share / Copy Link) -->
        <div class="w-full flex gap-2 pt-2.5 border-t border-stone-100 dark:border-stone-800/80">
          <button
            type="button"
            id="modal-share-btn"
            class="flex-1 py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-stone-800 dark:hover:bg-stone-700 text-white text-xs font-semibold shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
            </svg>
            <span id="modal-share-text">{initialData.ui.shareCard}</span>
          </button>

          <button
            type="button"
            id="modal-copy-url-btn"
            class="py-2 px-3 rounded-xl bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 text-xs font-semibold transition-colors cursor-pointer"
            title="کپی لینک"
          >
            <span id="modal-copy-url-text">{isEn ? "Copy URL" : "کپی لینک"}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Floating Toast Notification Banner -->
    <div id="toast-notify" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-slate-900/95 dark:bg-white/95 text-white dark:text-slate-900 text-xs font-semibold px-4 py-2.5 rounded-full shadow-xl flex items-center gap-2 pointer-events-none opacity-0 translate-y-3 transition-all duration-300">
      <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span id="toast-message">کپی شد!</span>
    </div>

    <!-- Interactive Client Script -->
    <script define:vars={{ landingDataFa, landingDataEn, defaultLang, qrSvgMarkup }}>
      // State
      let currentLang = defaultLang || 'fa';

      // Check URL query param ?lang=en or initial html lang
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('lang') === 'en' || document.documentElement.lang === 'en') {
        currentLang = 'en';
      }

      function showToast(msg) {
        const toast = document.getElementById('toast-notify');
        const toastMsg = document.getElementById('toast-message');
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.remove('opacity-0', 'translate-y-3');
        toast.classList.add('opacity-100', 'translate-y-0');
        setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-3');
        }, 2200);
      }

      function copyText(text, successMessage) {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(() => {
            showToast(successMessage || (currentLang === 'fa' ? 'در کلیپ‌بورد کپی شد!' : 'Copied to clipboard!'));
          }).catch(() => fallbackCopy(text, successMessage));
        } else {
          fallbackCopy(text, successMessage);
        }
      }

      function fallbackCopy(text, successMessage) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          document.execCommand('copy');
          showToast(successMessage || (currentLang === 'fa' ? 'در کلیپ‌بورد کپی شد!' : 'Copied to clipboard!'));
        } catch (err) {}
        document.body.removeChild(textArea);
      }

      // Generate and trigger vCard Download
      function downloadVCard() {
        const data = currentLang === 'en' ? landingDataEn : landingDataFa;
        const vcardData = [
          'BEGIN:VCARD',
          'VERSION:3.0',
          'N:Novand;;;;',
          `FN:${data.name} | Novand`,
          `ORG:${currentLang === 'en' ? 'Novand Integrated Technology & Infrastructure' : 'شرکت مهندسی نُوَند'}`,
          `TITLE:${data.tagline}`,
          `TEL;TYPE=CELL,VOICE:${data.phonePrimary}`,
          `TEL;TYPE=WORK,VOICE:${data.phoneSecondary}`,
          `EMAIL;TYPE=WORK:${data.emailAddress}`,
          'URL:https://novand-tech.com',
          `URL;TYPE=Instagram:${data.instagramUrl}`,
          `URL;TYPE=Telegram:${data.telegramUrl}`,
          `URL;TYPE=TelegramDirect:${data.telegramDirectUrl}`,
          `ADR;TYPE=WORK:;;${data.addressFull};Tehran;;;Iran`,
          'GEO:35.776182;51.378420',
          `NOTE:${data.bio}\\nPrimary Engineer: ${data.phonePrimaryContact} (${data.phonePrimaryDisplay})\\nSupport: ${data.phoneSecondaryContact} (${data.phoneSecondaryDisplay})`,
          'END:VCARD'
        ].join('\r\n');

        const blob = new Blob([vcardData], { type: 'text/vcard;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.setAttribute('download', 'Novand-Contact.vcf');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
        showToast(currentLang === 'fa' ? 'فایل مخاطب دانلود شد' : 'Contact file downloaded');
      }

      // Apply Language updates dynamically
      function applyLanguage(lang) {
        currentLang = lang;
        const data = lang === 'en' ? landingDataEn : landingDataFa;
        const isEn = lang === 'en';

        // Root HTML updates
        document.documentElement.lang = lang;
        document.documentElement.dir = isEn ? 'ltr' : 'rtl';
        if (isEn) {
          document.documentElement.classList.remove('font-vazirmatn');
        } else {
          document.documentElement.classList.add('font-vazirmatn');
        }

        // Toggle button text and title
        const langBtn = document.getElementById('lang-toggle-btn');
        if (langBtn) {
          langBtn.setAttribute('aria-label', data.ui.toggleLang);
          langBtn.setAttribute('title', isEn ? 'تغییر زبان به فارسی' : 'Switch to English');
        }
        const langBtnText = document.getElementById('lang-btn-text');
        if (langBtnText) langBtnText.textContent = isEn ? 'فا' : 'EN';

        // Top Status Pill
        const statusText = document.getElementById('status-pill-text');
        if (statusText) statusText.textContent = data.statusText;

        // Hero info
        const profileName = document.getElementById('profile-name');
        if (profileName) profileName.textContent = data.name;

        const profileSubname = document.getElementById('profile-subname');
        if (profileSubname) profileSubname.textContent = isEn ? 'Technology' : 'Novand';

        const profileTagline = document.getElementById('profile-tagline');
        if (profileTagline) profileTagline.textContent = data.tagline;

        const profileBio = document.getElementById('profile-bio');
        if (profileBio) profileBio.textContent = data.bio;

        // Action button labels
        const btnCall = document.getElementById('btn-call-text');
        if (btnCall) btnCall.textContent = data.callButtonText;

        const btnWhatsapp = document.getElementById('btn-whatsapp-text');
        if (btnWhatsapp) btnWhatsapp.textContent = data.whatsappLabel;

        const btnEmail = document.getElementById('btn-email-text');
        if (btnEmail) btnEmail.textContent = data.emailLabel;

        const btnVcard = document.getElementById('btn-vcard-text');
        if (btnVcard) btnVcard.textContent = data.vcardButtonText;

        // Drawer
        const drawerPhonesLabel = document.getElementById('drawer-phones-label');
        if (drawerPhonesLabel) drawerPhonesLabel.textContent = isEn ? 'Direct Engineering Lines' : 'خطوط ارتباطی مستقیم';

        const hotlineBadge = document.getElementById('hotline-badge');
        if (hotlineBadge) hotlineBadge.textContent = data.ui.technicalHotline;

        const phone1Label = document.getElementById('phone1-label');
        if (phone1Label) phone1Label.textContent = data.ui.primaryPhoneTitle;

        const phone1Contact = document.getElementById('phone1-contact');
        if (phone1Contact) phone1Contact.textContent = data.phonePrimaryContact;

        const phone1Number = document.getElementById('phone1-number');
        if (phone1Number) phone1Number.textContent = data.phonePrimaryDisplay;

        const phone2Label = document.getElementById('phone2-label');
        if (phone2Label) phone2Label.textContent = data.ui.secondaryPhoneTitle;

        const phone2Contact = document.getElementById('phone2-contact');
        if (phone2Contact) phone2Contact.textContent = data.phoneSecondaryContact;

        const phone2Number = document.getElementById('phone2-number');
        if (phone2Number) phone2Number.textContent = data.phoneSecondaryDisplay;

        const callBtn1 = document.getElementById('call-btn-1');
        if (callBtn1) callBtn1.textContent = data.ui.callNow;

        const callBtn2 = document.getElementById('call-btn-2');
        if (callBtn2) callBtn2.textContent = data.ui.callNow;

        const drawerTeleDirectBtn = document.getElementById('drawer-tele-direct-btn');
        if (drawerTeleDirectBtn) {
          drawerTeleDirectBtn.setAttribute('href', data.telegramDirectUrl);
          drawerTeleDirectBtn.setAttribute('title', data.ui.telegramDirectChat);
          drawerTeleDirectBtn.setAttribute('aria-label', data.ui.telegramDirectChat);
        }

        // Hub links
        const websiteLink = document.getElementById('website-main-link');
        if (websiteLink) websiteLink.setAttribute('href', isEn ? '/en' : '/');

        const linkWebTitle = document.getElementById('link-website-title');
        if (linkWebTitle) linkWebTitle.textContent = data.websiteLabel;

        const linkWebDesc = document.getElementById('link-website-desc');
        if (linkWebDesc) linkWebDesc.textContent = data.websiteDesc;

        const linkInstaTitle = document.getElementById('link-instagram-title');
        if (linkInstaTitle) linkInstaTitle.textContent = data.instagramLabel;

        const linkInstaDesc = document.getElementById('link-instagram-desc');
        if (linkInstaDesc) linkInstaDesc.textContent = data.instagramDesc;

        const linkTeleTitle = document.getElementById('link-telegram-title');
        if (linkTeleTitle) linkTeleTitle.textContent = data.telegramLabel;

        const linkTeleDesc = document.getElementById('link-telegram-desc');
        if (linkTeleDesc) linkTeleDesc.textContent = data.telegramDesc;

        // Direct Telegram Chat Hub Link
        const teleDirectLink = document.getElementById('telegram-direct-link');
        if (teleDirectLink) teleDirectLink.setAttribute('href', data.telegramDirectUrl);

        const linkTeleDirectTitle = document.getElementById('link-tele-direct-title');
        if (linkTeleDirectTitle) linkTeleDirectTitle.textContent = data.telegramDirectLabel;

        const linkTeleDirectPhone = document.getElementById('link-tele-direct-phone');
        if (linkTeleDirectPhone) linkTeleDirectPhone.textContent = data.telegramDirectPhone;

        const linkTeleDirectDesc = document.getElementById('link-tele-direct-desc');
        if (linkTeleDirectDesc) {
          linkTeleDirectDesc.innerHTML = isEn
            ? `<span>Direct engineering chat & consultation via <bdi dir="ltr" class="font-mono font-semibold">+98 919 691 8758</bdi></span>`
            : `<span>ارسال مستقیم و گفت‌وگوی مستقیم فنی با شماره <bdi dir="ltr" class="font-mono font-semibold">۰۹۱۹ ۶۹۱ ۸۷۵۸</bdi></span>`;
        }

        // Location & address
        const locationHeading = document.getElementById('location-heading');
        if (locationHeading) locationHeading.textContent = data.ui.officeLocation;

        const copyAddressText = document.getElementById('copy-address-text');
        if (copyAddressText) copyAddressText.textContent = data.ui.copy + ' ' + (isEn ? 'Address' : 'نشانی');

        const fullAddressText = document.getElementById('full-address-text');
        if (fullAddressText) fullAddressText.textContent = data.addressFull;

        const navGoogleBtn = document.getElementById('nav-google-btn');
        if (navGoogleBtn) {
          navGoogleBtn.setAttribute('href', data.maps.googleUrl);
          navGoogleBtn.querySelector('span').textContent = 'Google Maps';
        }

        const navNeshanBtn = document.getElementById('nav-neshan-btn');
        if (navNeshanBtn) {
          navNeshanBtn.setAttribute('href', data.maps.neshanUrl);
          navNeshanBtn.querySelector('span').textContent = isEn ? 'Neshan Map' : 'مسیریابی نشان';
        }

        const navBaladBtn = document.getElementById('nav-balad-btn');
        if (navBaladBtn) {
          navBaladBtn.setAttribute('href', data.maps.baladUrl);
          navBaladBtn.querySelector('span').textContent = isEn ? 'Balad Map' : 'مسیریابی بلد';
        }

        // Services
        const servicesHeading = document.getElementById('services-section-heading');
        if (servicesHeading) servicesHeading.textContent = data.servicesHeading;

        const divisionsBadge = document.getElementById('services-divisions-badge');
        if (divisionsBadge) divisionsBadge.textContent = data.ui.divisionsCount;

        const serviceCards = document.querySelectorAll('#services-grid > div');
        serviceCards.forEach((card, idx) => {
          if (data.services[idx]) {
            const titleEl = card.querySelector('.service-title');
            const descEl = card.querySelector('.service-desc');
            if (titleEl) titleEl.textContent = data.services[idx].title;
            if (descEl) descEl.textContent = data.services[idx].description;
          }
        });

        // Hours
        const hoursLabel = document.getElementById('hours-label');
        if (hoursLabel) hoursLabel.textContent = data.hours;

        const hoursNote = document.getElementById('hours-note');
        if (hoursNote) hoursNote.textContent = data.hoursNote + ' ' + data.consultationNotice;

        // Footer
        const footerTagline = document.getElementById('footer-tagline');
        if (footerTagline) footerTagline.textContent = data.tagline;

        const footerRights = document.getElementById('footer-rights');
        if (footerRights) footerRights.textContent = data.ui.allRightsReserved;

        const footerQrText = document.getElementById('footer-qr-text');
        if (footerQrText) footerQrText.textContent = data.ui.qrModalTitle;

        // QR Modal
        const qrModalTitle = document.getElementById('qr-modal-title');
        if (qrModalTitle) qrModalTitle.textContent = data.ui.qrModalTitle;

        const qrModalDesc = document.getElementById('qr-modal-desc');
        if (qrModalDesc) qrModalDesc.textContent = data.ui.qrModalDesc;

        const modalDownloadQrText = document.getElementById('modal-download-qr-text');
        if (modalDownloadQrText) modalDownloadQrText.textContent = data.ui.downloadQr + ' (PNG)';

        const modalShareText = document.getElementById('modal-share-text');
        if (modalShareText) modalShareText.textContent = data.ui.shareCard;

        const modalCopyUrlText = document.getElementById('modal-copy-url-text');
        if (modalCopyUrlText) modalCopyUrlText.textContent = isEn ? 'Copy URL' : 'کپی لینک';
      }

      // Initialize language
      if (currentLang === 'en') {
        applyLanguage('en');
      }

      // Language Switcher Click
      const langToggleBtn = document.getElementById('lang-toggle-btn');
      if (langToggleBtn) {
        langToggleBtn.addEventListener('click', () => {
          const nextLang = currentLang === 'fa' ? 'en' : 'fa';
          applyLanguage(nextLang);
          try {
            const url = new URL(window.location);
            url.searchParams.set('lang', nextLang);
            window.history.replaceState({}, '', url);
          } catch(e) {}
        });
      }

      // Theme Switcher Click (Syncs with novand_theme and BaseLayout)
      const themeToggleBtn = document.getElementById('card-theme-toggle');
      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark');
          const nextTheme = isDark ? 'light' : 'dark';
          if (nextTheme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
          try {
            localStorage.setItem('novand_theme', nextTheme);
          } catch(e) {}
        });
      }

      // vCard Button Click
      const vcardBtn = document.getElementById('btn-download-vcard');
      if (vcardBtn) {
        vcardBtn.addEventListener('click', downloadVCard);
      }

      // Call selector button scroll/toggle
      const callSelectorBtn = document.getElementById('btn-call-selector');
      if (callSelectorBtn) {
        callSelectorBtn.addEventListener('click', () => {
          const drawer = document.getElementById('phone-numbers-drawer');
          if (drawer) {
            drawer.scrollIntoView({ behavior: 'smooth', block: 'center' });
            drawer.classList.add('ring-2', 'ring-[#008f7a]', 'dark:ring-[#00d2b5]');
            setTimeout(() => {
              drawer.classList.remove('ring-2', 'ring-[#008f7a]', 'dark:ring-[#00d2b5]');
            }, 1200);
          }
        });
      }

      // Copy phone buttons
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const text = btn.getAttribute('data-copy');
          if (text) copyText(text, currentLang === 'fa' ? 'شماره تماس کپی شد' : 'Phone number copied');
        });
      });

      // Copy address button
      const copyAddressBtn = document.getElementById('copy-address-btn');
      if (copyAddressBtn) {
        copyAddressBtn.addEventListener('click', () => {
          const address = document.getElementById('full-address-text')?.textContent?.trim();
          if (address) copyText(address, currentLang === 'fa' ? 'نشانی دفتر کپی شد' : 'Address copied');
        });
      }

      // QR Code Modal Handlers
      const qrModal = document.getElementById('qr-modal');
      const openQrBtn = document.getElementById('open-qr-btn');
      const closeQrBtn = document.getElementById('close-qr-modal');

      function openModal() {
        if (qrModal) qrModal.classList.remove('hidden');
      }

      function closeModal() {
        if (qrModal) qrModal.classList.add('hidden');
      }

      const footerQrBtn = document.getElementById('footer-qr-btn');
      if (footerQrBtn) footerQrBtn.addEventListener('click', openModal);

      if (openQrBtn) openQrBtn.addEventListener('click', openModal);
      if (closeQrBtn) closeQrBtn.addEventListener('click', closeModal);
      if (qrModal) {
        qrModal.addEventListener('click', (e) => {
          if (e.target === qrModal) closeModal();
        });
      }

      // Download QR handlers
      const downloadQrPngBtn = document.getElementById('modal-download-qr-btn');
      if (downloadQrPngBtn) {
        downloadQrPngBtn.addEventListener('click', () => {
          showToast(currentLang === 'fa' ? 'دانلود تصویر کد QR آغاز شد' : 'Downloading QR code image...');
        });
      }

      const downloadQrSvgBtn = document.getElementById('modal-download-svg-btn');
      if (downloadQrSvgBtn) {
        downloadQrSvgBtn.addEventListener('click', () => {
          try {
            const blob = new Blob([qrSvgMarkup], { type: 'image/svg+xml;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'Novand-Digital-Card-QR.svg';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast(currentLang === 'fa' ? 'فایل وکتور SVG دانلود شد' : 'Vector SVG downloaded');
          } catch (e) {
            showToast(currentLang === 'fa' ? 'خطا در دریافت فایل' : 'Failed to download');
          }
        });
      }

      // Share or Copy card link
      function shareCard() {
        const data = currentLang === 'en' ? landingDataEn : landingDataFa;
        const shareData = {
          title: data.name + ' | ' + data.tagline,
          text: data.bio,
          url: window.location.href.split('?')[0]
        };
        if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
          navigator.share(shareData).catch(() => {});
        } else {
          copyText(shareData.url, currentLang === 'fa' ? 'پیوند کارت در کلیپ‌بورد کپی شد' : 'Card link copied');
        }
      }

      const modalShareBtn = document.getElementById('modal-share-btn');
      if (modalShareBtn) modalShareBtn.addEventListener('click', shareCard);

      const modalCopyUrlBtn = document.getElementById('modal-copy-url-btn');
      if (modalCopyUrlBtn) {
        modalCopyUrlBtn.addEventListener('click', () => {
          copyText(window.location.href.split('?')[0], currentLang === 'fa' ? 'پیوند کارت کپی شد' : 'Card link copied');
        });
      }

      // Close on escape
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && qrModal && !qrModal.classList.contains('hidden')) {
          closeModal();
        }
      });
    </script>
  </body>
</html>
