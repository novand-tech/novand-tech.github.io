---
import { getServicesData } from "../../data/services";
import { getSolutionsData } from "../../data/solutions";
import NovandLogo from '../ui/NovandLogo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const solutionsData = getSolutionsData(currentPath);
const servicesData = getServicesData(currentPath);
const isEn = currentPath.startsWith('/en');

const targetLangUrl = currentPath.startsWith('/en')
  ? (currentPath.replace(/^\/en/, '') || '/')
  : ('/en' + (currentPath === '/' ? '' : currentPath));

const navLinks = isEn ? [
  { label: 'Projects', href: '/en/projects' },
  { label: 'About', href: '/en/about' },
  { label: 'Consulting', href: '/en/consulting' },
  { label: 'Contact', href: '/en/contact' },
] : [
  { label: 'پروژه‌ها', href: '/projects' },
  { label: 'درباره ما', href: '/about' },
  { label: 'مشاوره', href: '/consulting' },
  { label: 'تماس', href: '/contact' },
];

---
<header class="sticky top-0 z-50 w-full bg-[#0d1417]/95 backdrop-blur-md border-b border-[#15120e] transition-colors keep-dark text-[#f4f2f1]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo (Smart Building & Circuit Infrastructure) -->
      <a href={isEn ? "/en" : "/"} class="header-brand-link flex items-center gap-3.5 group focus-visible:outline-2 focus-visible:outline-offset-2" aria-label="Novand">
        <div class="logo-wrapper w-9 h-9 text-[#f4f2f1] flex items-center justify-center transition-all duration-300 group-hover:scale-105 group-hover:text-[#00d2b5] group-hover:drop-shadow-[0_0_14px_rgba(0,210,181,0.6)]">
          <NovandLogo />
        </div>
        <div class="flex flex-col">
          <span class="header-logo-title text-base font-bold tracking-tight uppercase text-[#f4f2f1] group-hover:text-[#00d2b5] transition-colors duration-300 font-sans">
            Novand
          </span>
          <span class="header-logo-subtitle text-[9px] uppercase font-mono tracking-[0.2em] text-[#f4f2f1]/50 group-hover:text-[#10b981] transition-colors duration-300">
            {isEn ? 'Integrated Tech & Infrastructure' : 'فناوری یکپارچه و زیرساخت'}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1.5" aria-label="Main Navigation">
        
        <!-- Services Mega Dropdown -->
        <div class="relative group/menu">
          <button 
            type="button" 
            class="flex items-center gap-1.5 px-3 py-2 text-[11px] uppercase tracking-[0.2em] font-medium text-[#f4f2f1]/80 hover:text-[#00d2b5] transition-colors focus-visible:outline-none"
            aria-expanded="false"
            aria-haspopup="true"
            id="services-menu-btn"
          >
            <span>{isEn ? 'Services' : 'خدمات'}</span>
            <svg class="w-3 h-3 text-[#f4f2f1]/60 group-hover/menu:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Dropdown Panel -->
          <div 
            class="absolute left-0 rtl:right-0 rtl:left-auto top-full pt-2 opacity-0 -translate-y-1 pointer-events-none group-hover/menu:opacity-100 group-hover/menu:translate-y-0 group-hover/menu:pointer-events-auto transition-all duration-200 w-[580px]"
            id="services-dropdown"
          >
            <div class="bg-[#0d1417] border border-[#15120e] shadow-2xl p-4 grid grid-cols-2 gap-2">
              <div class="col-span-2 pb-2 mb-2 border-b border-[#15120e] flex items-center justify-between">
                <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70">{isEn ? 'Core Engineering Disciplines' : 'حوزه‌های مهندسی'}</span>
                <a href={isEn ? "/en/services" : "/services"} class="text-xs text-[#f4f2f1]/60 hover:text-[#00d2b5] transition-colors font-medium">
                  {isEn ? 'View All Services →' : 'مشاهده همه خدمات ←'}
                </a>
              </div>
              {servicesData.map((service) => (
                <a 
                  href={isEn ? `/en/services/${service.slug}` : `/services/${service.slug}`}
                  class="p-2.5 hover:bg-[#15120e] transition-colors group/item block border border-transparent hover:border-[#00d2b5]/30"
                >
                  <p class="text-sm font-medium text-[#f4f2f1] group-hover/item:text-[#00d2b5] transition-colors leading-tight">
                    {service.title}
                  </p>
                  <p class="text-xs text-[#f4f2f1]/50 line-clamp-1 mt-1 font-mono">
                    {service.eyebrow}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Solutions Dropdown -->
        <div class="relative group/menu">
          <button 
            type="button" 
            class="flex items-center gap-1.5 px-3 py-2 text-[11px] uppercase tracking-[0.2em] font-medium text-[#f4f2f1]/80 hover:text-[#00d2b5] transition-colors focus-visible:outline-none"
            aria-expanded="false"
            aria-haspopup="true"
            id="solutions-menu-btn"
          >
            <span>{isEn ? 'Solutions' : 'راهکارها'}</span>
            <svg class="w-3 h-3 text-[#f4f2f1]/60 group-hover/menu:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Dropdown Panel -->
          <div 
            class="absolute left-0 rtl:right-0 rtl:left-auto top-full pt-2 opacity-0 -translate-y-1 pointer-events-none group-hover/menu:opacity-100 group-hover/menu:translate-y-0 group-hover/menu:pointer-events-auto transition-all duration-200 w-[420px]"
            id="solutions-dropdown"
          >
            <div class="bg-[#0d1417] border border-[#15120e] shadow-2xl p-4 flex flex-col gap-1.5">
              <div class="pb-2 mb-1 border-b border-[#15120e] flex items-center justify-between">
                <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70">{isEn ? 'By Facility Environment' : 'بر اساس محیط'}</span>
                <a href={isEn ? "/en/solutions" : "/solutions"} class="text-xs text-[#f4f2f1]/60 hover:text-[#00d2b5] transition-colors font-medium">
                  {isEn ? 'All Solutions →' : 'همه راهکارها ←'}
                </a>
              </div>
              {solutionsData.map((solution) => (
                <a 
                  href={isEn ? `/en/solutions/${solution.slug}` : `/solutions/${solution.slug}`}
                  class="p-2 hover:bg-[#15120e] transition-colors group/item block border border-transparent hover:border-[#00d2b5]/30"
                >
                  <p class="text-sm font-medium text-[#f4f2f1] group-hover/item:text-[#00d2b5] transition-colors">
                    {solution.title}
                  </p>
                  <p class="text-xs text-[#f4f2f1]/50 line-clamp-1 mt-0.5">
                    {solution.summary}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Static Links -->
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a 
              href={link.href}
              class={`px-3 py-2 text-[11px] uppercase tracking-[0.2em] font-medium transition-colors ${
                isActive 
                  ? 'text-[#00d2b5] font-bold' 
                  : 'text-[#f4f2f1]/80 hover:text-[#00d2b5]'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Action CTA (Desktop) -->
      <div class="hidden lg:flex items-center gap-3">
        <!-- Language Switcher -->
        <a 
          href={targetLangUrl} 
          aria-label={isEn ? "Switch language to Persian" : "تغییر زبان به انگلیسی"}
          class="text-[11px] uppercase tracking-widest font-mono font-medium text-[#f4f2f1]/80 hover:text-[#f6f2ee] transition-colors flex items-center gap-1 border border-[#15120e] px-2 py-1.5 hover:bg-[#15120e]"
        >
          {isEn ? 'FA / فارسی' : 'EN'}
        </a>

        <!-- Theme Switcher (Desktop) -->
        <button 
          type="button" 
          id="theme-toggle-btn"
          aria-label={isEn ? "Switch to dark theme" : "تغییر به حالت تیره"}
          class="theme-toggle-btn group text-[11px] font-mono text-[#f4f2f1]/80 hover:text-[#00d2b5] transition-all duration-200 flex items-center justify-center p-2 border border-[#15120e] hover:border-[#00d2b5]/40 hover:bg-[#15120e] cursor-pointer rounded-sm"
          title={isEn ? "Toggle dark / light theme" : "تغییر حالت تیره / روشن"}
        >
          <!-- Sun Icon (shown in dark mode, click to switch to light) -->
          <svg class="w-4 h-4 hidden dark:block text-[#00d2b5] transition-transform duration-300 group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon Icon (shown in light mode, click to switch to dark) -->
          <svg class="w-4 h-4 block dark:hidden text-[#00d2b5] group-hover:text-[#00d2b5] transition-transform duration-300 group-hover:-rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a 
          href={isEn ? "/en/contact" : "/contact"} 
          class="inline-flex items-center justify-center font-medium transition-all duration-200 text-center select-none cursor-pointer text-[10px] px-4 py-2 uppercase font-bold tracking-widest bg-transparent text-[#f4f2f1] border border-[#f4f2f1]/40 hover:border-[#f4f2f1] hover:text-[#ffffff] hover:bg-white/10 rounded-xs"
        >
          {isEn ? 'Technical Inquiries' : 'سوالات فنی'}
        </a>
        <a 
          href={isEn ? "/en/contact#consultation" : "/contact#consultation"} 
          class="header-consultation-btn inline-flex items-center justify-center font-medium transition-all duration-200 text-center select-none cursor-pointer text-[10px] px-4 py-2 uppercase font-bold tracking-widest bg-[#f4f2f1] text-[#141210] hover:bg-[#ffffff] hover:text-[#141210] border border-transparent shadow-xs rounded-xs"
        >
          {isEn ? 'Request Consultation' : 'درخواست مشاوره'}
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a 
          href={targetLangUrl} 
          aria-label={isEn ? "Switch language to Persian" : "تغییر زبان به انگلیسی"}
          class="text-[10px] uppercase font-mono text-[#f4f2f1]/80 border border-[#15120e] px-2 py-1"
        >
          {isEn ? 'FA' : 'EN'}
        </a>

        <!-- Theme Switcher (Mobile) -->
        <button 
          type="button" 
          id="theme-toggle-btn-mobile"
          aria-label={isEn ? "Switch to dark theme" : "تغییر به حالت تیره"}
          class="theme-toggle-btn group text-[10px] font-mono text-[#f4f2f1]/80 hover:text-[#00d2b5] border border-[#15120e] hover:border-[#00d2b5]/40 p-1.5 flex items-center justify-center hover:bg-[#15120e] cursor-pointer rounded-sm transition-all duration-200"
          title={isEn ? "Toggle dark / light theme" : "تغییر حالت تیره / روشن"}
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg class="w-4 h-4 hidden dark:block text-[#00d2b5] transition-transform duration-300 group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg class="w-4 h-4 block dark:hidden text-[#00d2b5] group-hover:text-[#00d2b5] transition-transform duration-300 group-hover:-rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a 
          href={isEn ? "/en/contact#consultation" : "/contact#consultation"} 
          class="header-consultation-btn inline-flex items-center justify-center font-medium transition-all duration-200 text-center select-none cursor-pointer text-[10px] py-1 px-3 uppercase font-bold tracking-widest bg-[#f4f2f1] text-[#141210] hover:bg-[#ffffff] hover:text-[#141210] border border-transparent rounded-xs"
        >
          {isEn ? 'Consultation' : 'مشاوره'}
        </a>
        <button 
          type="button" 
          id="mobile-menu-btn"
          aria-expanded="false" 
          aria-controls="mobile-menu-drawer"
          aria-label="Toggle navigation menu"
          class="p-2 text-[#f4f2f1] hover:bg-[#15120e] border border-[#15120e] transition-colors"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div 
    id="mobile-menu-drawer" 
    class="hidden lg:hidden bg-[#0d1417] border-b border-[#15120e] px-4 pt-3 pb-8 transition-all max-h-[85vh] overflow-y-auto"
  >
    <div class="flex flex-col space-y-4">
      
      <div>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70 block mb-2 px-2">{isEn ? "Services" : "خدمات"}</span>
        <div class="grid grid-cols-1 gap-1 border-l border-[#15120e] pl-3">
          <a href={isEn ? "/en/services" : "/services"} class="text-sm font-medium text-[#f4f2f1] hover:text-white py-1.5 block">{isEn ? 'Overview of Services' : 'مروری بر خدمات'}</a>
          {servicesData.map((service) => (
            <a href={isEn ? `/en/services/${service.slug}` : `/services/${service.slug}`} class="text-xs text-[#f4f2f1]/60 hover:text-[#f4f2f1] py-1.5 block">
              {service.title}
            </a>
          ))}
        </div>
      </div>

      <div>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70 block mb-2 px-2">{isEn ? "Solutions" : "راهکارها"}</span>
        <div class="grid grid-cols-1 gap-1 border-l border-[#15120e] pl-3">
          <a href={isEn ? "/en/solutions" : "/solutions"} class="text-sm font-medium text-[#f4f2f1] hover:text-white py-1.5 block">{isEn ? 'Overview of Solutions' : 'مروری بر راهکارها'}</a>
          {solutionsData.map((solution) => (
            <a href={isEn ? `/en/solutions/${solution.slug}` : `/solutions/${solution.slug}`} class="text-xs text-[#f4f2f1]/60 hover:text-[#f4f2f1] py-1.5 block">
              {solution.title}
            </a>
          ))}
        </div>
      </div>

      <div class="border-t border-[#15120e] pt-3 flex flex-col space-y-2">
        <a href={isEn ? "/en/projects" : "/projects"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'Projects & Case Models' : 'پروژه‌ها و نمونه‌ها'}</a>
        <a href={isEn ? "/en/about" : "/about"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'About & Methodology' : 'درباره و متدولوژی'}</a>
        <a href={isEn ? "/en/consulting" : "/consulting"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'Equipment Advisory & Consulting' : 'مشاوره و تامین تجهیزات'}</a>
        <a href={isEn ? "/en/contact" : "/contact"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'Contact & Operations' : 'تماس و عملیات'}</a>
      </div>

      <div class="pt-4 border-t border-[#15120e]">
        <a 
          href={isEn ? "/en/contact#consultation" : "/contact#consultation"} 
          class="header-consultation-btn inline-flex items-center justify-center font-medium transition-all duration-200 text-center select-none cursor-pointer text-[11px] px-6 py-2.5 uppercase font-bold tracking-widest w-full bg-[#f4f2f1] text-[#141210] hover:bg-[#ffffff] hover:text-[#141210] border border-transparent rounded-xs"
        >
          {isEn ? 'Request Consultation' : 'درخواست مشاوره'}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Accessible mobile toggle with keyboard support
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');

  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileDrawer.classList.toggle('hidden');
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileDrawer.classList.contains('hidden')) {
        mobileBtn.setAttribute('aria-expanded', 'false');
        mobileDrawer.classList.add('hidden');
        mobileBtn.focus();
      }
    });
  }

  // Accessible theme toggle with persistence and zero latency
  function updateThemeUI(theme: string) {
    const isDark = theme === 'dark';
    const isEn = document.documentElement.lang === 'en';
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');
    buttons.forEach((btn) => {
      btn.setAttribute(
        'aria-label',
        isDark
          ? (isEn ? 'Switch to light theme' : 'تغییر به حالت روشن')
          : (isEn ? 'Switch to dark theme' : 'تغییر به حالت تیره')
      );
    });
    const metaThemeColor = document.getElementById('meta-theme-color');
    if (metaThemeColor) {
      metaThemeColor.setAttribute('content', isDark ? '#141210' : '#ffffff');
    }
  }

  function toggleTheme() {
    const currentIsDark = document.documentElement.classList.contains('dark');
    const newTheme = currentIsDark ? 'light' : 'dark';
    if (newTheme === 'dark') {
      document.documentElement.classList.add('dark');
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.classList.remove('dark');
      document.documentElement.setAttribute('data-theme', 'light');
    }
    try {
      localStorage.setItem('novand_theme', newTheme);
    } catch (e) {}
    updateThemeUI(newTheme);
    window.dispatchEvent(new CustomEvent('novand-theme-change', { detail: { theme: newTheme } }));
  }

  document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', toggleTheme);
  });

  const initialTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  updateThemeUI(initialTheme);
</script>