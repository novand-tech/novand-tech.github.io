---
const solutionsData = getSolutionsData(Astro.url.pathname);
const servicesData = getServicesData(Astro.url.pathname);
import { getServicesData } from "../../data/services";
import { getSolutionsData } from "../../data/solutions";
import Button from '../ui/Button.astro';
import NovandLogo from '../ui/NovandLogo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;


const isEn = currentPath.startsWith('/en');

const navLinks = isEn ? [
  { label: 'Projects', href: '/en/projects' },
  { label: 'About', href: '/en/about' },
  { label: 'Consulting', href: '/en/consulting' },
  { label: 'Contact', href: '/en/contact' },
] : [
  { label: 'پروژه‌ها', href: '/projects' },
  { label: 'درباره ما', href: '/about' },
  { label: 'مشاوره', href: '/consulting' },
  { label: 'تماس', href: '/contact' },
];

---
<header class="sticky top-0 z-50 w-full bg-[#0d1417]/95 backdrop-blur-md border-b border-[#15120e] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo (Smart Building & Circuit Infrastructure) -->
      <a href={isEn ? "/en" : "/"} class="flex items-center gap-3.5 group focus-visible:outline-2 focus-visible:outline-offset-2">
        <div class="logo-wrapper w-9 h-9 text-[#f4f2f1] flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
          <NovandLogo />
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold tracking-tight uppercase text-[#f4f2f1] group-hover:text-white transition-colors font-sans">
            Novand
          </span>
          <span class="text-[9px] uppercase font-mono tracking-[0.2em] text-[#f4f2f1] opacity-50">
            {isEn ? 'Integrated Tech & Infrastructure' : 'فناوری یکپارچه و زیرساخت'}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-2" aria-label="Main Navigation">
        
        <!-- Services Mega Dropdown -->
        <div class="relative group/menu">
          <button 
            type="button" 
            class="flex items-center gap-1.5 px-3 py-2 text-[11px] uppercase tracking-[0.2em] font-medium text-[#f4f2f1]/80 hover:text-[#f6f2ee] transition-colors focus-visible:outline-none"
            aria-expanded="false"
            aria-haspopup="true"
            id="services-menu-btn"
          >
            <span>{isEn ? 'Services' : 'خدمات'}</span>
            <svg class="w-3 h-3 text-[#f4f2f1]/60 group-hover/menu:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Dropdown Panel -->
          <div 
            class="absolute left-0 rtl:right-0 rtl:left-auto top-full pt-2 opacity-0 pointer-events-none group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto transition-all duration-200 w-[580px]"
            id="services-dropdown"
          >
            <div class="bg-[#0d1417] border border-[#15120e] shadow-2xl p-4 grid grid-cols-2 gap-2">
              <div class="col-span-2 pb-2 mb-2 border-b border-[#15120e] flex items-center justify-between">
                <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70">{isEn ? 'Core Engineering Disciplines' : 'حوزه‌های مهندسی'}</span>
                <a href={isEn ? "/en/services" : "/services"} class="text-xs text-[#f4f2f1]/60 hover:text-[#f4f2f1] transition-colors font-medium">
                  {isEn ? 'View All Services →' : 'مشاهده همه خدمات ←'}
                </a>
              </div>
              {servicesData.map((service) => (
                <a 
                  href={isEn ? `/en/services/${service.slug}` : `/services/${service.slug}`}
                  class="p-2.5 hover:bg-[#15120e] transition-colors group/item block border border-transparent hover:border-[#f4f2f1]/20"
                >
                  <p class="text-sm font-medium text-[#f4f2f1] group-hover/item:text-white transition-colors leading-tight">
                    {service.title}
                  </p>
                  <p class="text-xs text-[#f4f2f1]/50 line-clamp-1 mt-1 font-mono">
                    {service.eyebrow}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Solutions Dropdown -->
        <div class="relative group/menu">
          <button 
            type="button" 
            class="flex items-center gap-1.5 px-3 py-2 text-[11px] uppercase tracking-[0.2em] font-medium text-[#f4f2f1]/80 hover:text-[#f6f2ee] transition-colors focus-visible:outline-none"
            aria-expanded="false"
            aria-haspopup="true"
            id="solutions-menu-btn"
          >
            <span>{isEn ? 'Solutions' : 'راهکارها'}</span>
            <svg class="w-3 h-3 text-[#f4f2f1]/60 group-hover/menu:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <!-- Dropdown Panel -->
          <div 
            class="absolute left-0 rtl:right-0 rtl:left-auto top-full pt-2 opacity-0 pointer-events-none group-hover/menu:opacity-100 group-hover/menu:pointer-events-auto transition-all duration-200 w-[420px]"
            id="solutions-dropdown"
          >
            <div class="bg-[#0d1417] border border-[#15120e] shadow-2xl p-4 flex flex-col gap-1.5">
              <div class="pb-2 mb-1 border-b border-[#15120e] flex items-center justify-between">
                <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70">{isEn ? 'By Facility Environment' : 'بر اساس محیط'}</span>
                <a href={isEn ? "/en/solutions" : "/solutions"} class="text-xs text-[#f4f2f1]/60 hover:text-[#f4f2f1] transition-colors font-medium">
                  {isEn ? 'All Solutions →' : 'همه راهکارها ←'}
                </a>
              </div>
              {solutionsData.map((solution) => (
                <a 
                  href={isEn ? `/en/solutions/${solution.slug}` : `/solutions/${solution.slug}`}
                  class="p-2 hover:bg-[#15120e] transition-colors group/item block border border-transparent hover:border-[#f4f2f1]/20"
                >
                  <p class="text-sm font-medium text-[#f4f2f1] group-hover/item:text-white transition-colors">
                    {solution.title}
                  </p>
                  <p class="text-xs text-[#f4f2f1]/50 line-clamp-1 mt-0.5">
                    {solution.summary}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Static Links -->
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a 
              href={link.href}
              class={`px-3 py-2 text-[11px] uppercase tracking-[0.2em] font-medium transition-colors ${
                isActive 
                  ? 'text-[#f4f2f1] font-bold' 
                  : 'text-[#f4f2f1]/80 hover:text-[#f6f2ee]'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Action CTA (Desktop) -->
      <div class="hidden lg:flex items-center gap-3">
        <!-- Language Switcher -->
        <a href={currentPath.startsWith('/en') ? currentPath.replace('/en', '') || '/' : '/en' + (currentPath === '/' ? '' : currentPath)} class="text-[11px] uppercase tracking-widest font-mono font-medium text-[#f4f2f1]/80 hover:text-[#f6f2ee] transition-colors flex items-center gap-1 border border-[#15120e] px-2 py-1.5 hover:bg-[#15120e]">
          {currentPath.startsWith('/en') ? 'FA / فارسی' : 'EN'}
        </a>

        <Button href={isEn ? "/en/contact" : "/contact"} variant="outline" size="sm">
          {isEn ? 'Technical Inquiries' : 'سوالات فنی'}
        </Button>
        <Button href={isEn ? "/en/contact#consultation" : "/contact#consultation"} variant="primary" size="sm">
          {isEn ? 'Request Consultation' : 'درخواست مشاوره'}
        </Button>
      </div>

      <!-- Mobile Menu Toggle Button -->
      
      <div class="flex lg:hidden items-center gap-2">
        <a href={currentPath.startsWith('/en') ? currentPath.replace('/en', '') || '/' : '/en' + (currentPath === '/' ? '' : currentPath)} class="text-[10px] uppercase font-mono text-[#f4f2f1]/80 border border-[#15120e] px-2 py-1">
          {currentPath.startsWith('/en') ? 'FA' : 'EN'}
        </a>

        <Button href={isEn ? "/en/contact#consultation" : "/contact#consultation"} variant="primary" size="sm" class="text-[10px] py-1 px-3">
          {isEn ? 'Consultation' : 'مشاوره'}
        </Button>
        <button 
          type="button" 
          id="mobile-menu-btn"
          aria-expanded="false" 
          aria-controls="mobile-menu-drawer"
          aria-label="Toggle navigation menu"
          class="p-2 text-[#f4f2f1] hover:bg-[#15120e] border border-[#15120e] transition-colors"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div 
    id="mobile-menu-drawer" 
    class="hidden lg:hidden bg-[#0d1417] border-b border-[#15120e] px-4 pt-3 pb-8 transition-all max-h-[85vh] overflow-y-auto"
  >
    <div class="flex flex-col space-y-4">
      
      <div>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70 block mb-2 px-2">{isEn ? "Services" : "خدمات"}</span>
        <div class="grid grid-cols-1 gap-1 border-l border-[#15120e] pl-3">
          <a href={isEn ? "/en/services" : "/services"} class="text-sm font-medium text-[#f4f2f1] hover:text-white py-1.5 block">{isEn ? 'Overview of Services' : 'مروری بر خدمات'}</a>
          {servicesData.map((service) => (
            <a href={isEn ? `/en/services/${service.slug}` : `/services/${service.slug}`} class="text-xs text-[#f4f2f1]/60 hover:text-[#f4f2f1] py-1.5 block">
              {service.title}
            </a>
          ))}
        </div>
      </div>

      <div>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#f6f2ee] opacity-70 block mb-2 px-2">{isEn ? "Solutions" : "راهکارها"}</span>
        <div class="grid grid-cols-1 gap-1 border-l border-[#15120e] pl-3">
          <a href={isEn ? "/en/solutions" : "/solutions"} class="text-sm font-medium text-[#f4f2f1] hover:text-white py-1.5 block">{isEn ? 'Overview of Solutions' : 'مروری بر راهکارها'}</a>
          {solutionsData.map((solution) => (
            <a href={isEn ? `/en/solutions/${solution.slug}` : `/solutions/${solution.slug}`} class="text-xs text-[#f4f2f1]/60 hover:text-[#f4f2f1] py-1.5 block">
              {solution.title}
            </a>
          ))}
        </div>
      </div>

      <div class="border-t border-[#15120e] pt-3 flex flex-col space-y-2">
        <a href={isEn ? "/en/projects" : "/projects"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'Projects & Case Models' : 'پروژه‌ها و نمونه‌ها'}</a>
        <a href={isEn ? "/en/about" : "/about"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'About & Methodology' : 'درباره و متدولوژی'}</a>
        <a href={isEn ? "/en/consulting" : "/consulting"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'Equipment Advisory & Consulting' : 'مشاوره و تامین تجهیزات'}</a>
        <a href={isEn ? "/en/contact" : "/contact"} class="text-sm font-medium text-[#f4f2f1]/80 hover:text-white py-1 px-2">{isEn ? 'Contact & Operations' : 'تماس و عملیات'}</a>
      </div>

      <div class="pt-4 border-t border-[#15120e]">
        <Button href={isEn ? "/en/contact#consultation" : "/contact#consultation"} variant="primary" size="md" class="w-full">
          {isEn ? 'Request Consultation' : 'درخواست مشاوره'}
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Accessible mobile toggle with keyboard support
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');

  if (mobileBtn && mobileDrawer) {
    mobileBtn.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileDrawer.classList.toggle('hidden');
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileDrawer.classList.contains('hidden')) {
        mobileBtn.setAttribute('aria-expanded', 'false');
        mobileDrawer.classList.add('hidden');
        mobileBtn.focus();
      }
    });
  }
</script>