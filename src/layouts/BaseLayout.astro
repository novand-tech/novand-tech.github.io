---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getCompanyData } from "../data/company";
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const currentPath = Astro.url.pathname;
const companyData = getCompanyData(currentPath);

const {
  title,
  description = companyData.heroCopy,
  canonicalUrl = Astro.url.href,
  ogImage = "/images/hero-datacenter.jpg",
  type = "website"
} = Astro.props;

const lang = currentPath.startsWith("/en") ? "en" : "fa";
const dir = lang === "fa" ? "rtl" : "ltr";

const siteTitle = title.includes(companyData.shortName) ? title : `${title} | ${companyData.shortName}`;

const persianPath = currentPath.startsWith("/en") ? (currentPath.replace(/^\/en/, "") || "/") : currentPath;
const englishPath = currentPath.startsWith("/en") ? currentPath : ("/en" + (currentPath === "/" ? "" : currentPath));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EngineeringCompany",
  "name": companyData.name,
  "alternateName": companyData.shortName,
  "description": companyData.heroCopy,
  "url": Astro.site ? String(Astro.site) : "https://novand-tech.com",
  "telephone": (companyData.contactInfo.phones || [companyData.contactInfo.phone]).join(", "),
  "email": companyData.contactInfo.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": companyData.contactInfo.address,
    "addressLocality": "Tehran",
    "addressCountry": "IR"
  },
  "knowsAbout": companyData.capabilities
};
---
<!doctype html>
<html lang={lang} dir={dir} class={lang === "fa" ? "font-vazirmatn" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" id="meta-theme-color" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Immediate Theme Initialization (Zero FOUC, Default = Light) -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('novand_theme');
          var theme = stored === 'dark' ? 'dark' : 'light';
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Multilingual Hreflang Tags -->
    <link rel="alternate" hreflang="fa" href={`https://novand-tech.com${persianPath}`} />
    <link rel="alternate" hreflang="en" href={`https://novand-tech.com${englishPath}`} />
    <link rel="alternate" hreflang="x-default" href={`https://novand-tech.com${persianPath}`} />

    <!-- Open Graph / Social -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={companyData.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Typography: Vazirmatn & Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Vazirmatn:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-900 dark:bg-[#141210] dark:text-[#f4f2f1] transition-colors duration-150">
    
    <!-- Accessibility Landmark: Skip Link -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#f4f2f1] focus:text-[#141210] focus:font-semibold focus:shadow-lg focus:border focus:border-[#15120e]"
    >
      {lang === "en" ? "Skip to main content" : "پرش به محتوای اصلی"}
    </a>

    <Header currentPath={Astro.url.pathname} />

    <main id="main-content" class="flex-grow focus:outline-none">
      <slot />
    </main>

    <Footer />
  </body>
</html>
