  <!-- Dynamic Theme & Tab Switcher Script -->
  <script is:inline>
    (function() {
      var currentTheme = 'dark';
      var currentTab = 'outside';

      var btnDark = document.getElementById('btn-brochure-dark');
      var btnLight = document.getElementById('btn-brochure-light');
      var btnTabOutside = document.getElementById('btn-tab-outside');
      var btnTabInside = document.getElementById('btn-tab-inside');

      var viewOutside = document.getElementById('view-spread-outside');
      var viewInside = document.getElementById('view-spread-inside');

      var imgOutside = document.getElementById('img-spread-outside');
      var imgInside = document.getElementById('img-spread-inside');
      var linkOutsideSvg = document.getElementById('link-outside-svg');
      var linkOutsidePng = document.getElementById('link-outside-png');
      var linkInsideSvg = document.getElementById('link-inside-svg');
      var linkInsidePng = document.getElementById('link-inside-png');

      var panelImgs = document.querySelectorAll('.panel-preview-img');

      function updateTheme(theme) {
        currentTheme = theme;
        if (theme === 'dark') {
          btnDark.className = 'brochure-theme-btn flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-slate-900 text-white dark:bg-[#00d2b5] dark:text-[#0d1417] shadow-sm';
          btnLight.className = 'brochure-theme-btn flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-stone-100 hover:bg-stone-200 dark:bg-[#1a252b] dark:hover:bg-[#223139] text-stone-700 dark:text-stone-300';
        } else {
          btnLight.className = 'brochure-theme-btn flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-slate-900 text-white dark:bg-[#00d2b5] dark:text-[#0d1417] shadow-sm';
          btnDark.className = 'brochure-theme-btn flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-stone-100 hover:bg-stone-200 dark:bg-[#1a252b] dark:hover:bg-[#223139] text-stone-700 dark:text-stone-300';
        }

        // Update Spread Images & Links
        imgOutside.src = '/branding/novand-brochure-spread-outside-' + theme + '.png';
        imgInside.src = '/branding/novand-brochure-spread-inside-' + theme + '.png';

        linkOutsideSvg.href = '/branding/novand-brochure-spread-outside-' + theme + '.svg';
        linkOutsidePng.href = '/branding/novand-brochure-spread-outside-' + theme + '.png';
        linkInsideSvg.href = '/branding/novand-brochure-spread-inside-' + theme + '.svg';
        linkInsidePng.href = '/branding/novand-brochure-spread-inside-' + theme + '.png';

        // Update Page Grid Previews
        panelImgs.forEach(function(img) {
          var p = img.getAttribute('data-page');
          img.src = '/branding/novand-brochure-' + theme + '-p' + p + '.png';
        });
      }

      function updateTab(tab) {
        currentTab = tab;
        if (tab === 'outside') {
          viewOutside.classList.remove('hidden');
          viewInside.classList.add('hidden');
          btnTabOutside.className = 'brochure-spread-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-[#008f7a] dark:bg-[#10b981] text-white dark:text-[#0d1417]';
          btnTabInside.className = 'brochure-spread-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-stone-100 hover:bg-stone-200 dark:bg-[#1a252b] dark:hover:bg-[#223139] text-stone-700 dark:text-stone-300';
        } else {
          viewInside.classList.remove('hidden');
          viewOutside.classList.add('hidden');
          btnTabInside.className = 'brochure-spread-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-[#008f7a] dark:bg-[#10b981] text-white dark:text-[#0d1417]';
          btnTabOutside.className = 'brochure-spread-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold font-sans transition-all cursor-pointer bg-stone-100 hover:bg-stone-200 dark:bg-[#1a252b] dark:hover:bg-[#223139] text-stone-700 dark:text-stone-300';
        }
      }

      if (btnDark) btnDark.addEventListener('click', function() { updateTheme('dark'); });
      if (btnLight) btnLight.addEventListener('click', function() { updateTheme('light'); });
      if (btnTabOutside) btnTabOutside.addEventListener('click', function() { updateTab('outside'); });
      if (btnTabInside) btnTabInside.addEventListener('click', function() { updateTab('inside'); });
    })();
  </script>
