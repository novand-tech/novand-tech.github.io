---
import QRCode from 'qrcode';
import { landingDataFa, landingDataEn } from '../../data/adLandingData';
import NovandLogo from '../ui/NovandLogo.astro';
import '../../styles/global.css';

interface Props {
  defaultLang?: 'fa' | 'en';
}

const { defaultLang = 'fa' } = Astro.props;

// Pre-generate crisp offline SVG and PNG QR codes for the business card URL
const canonicalCardUrl = 'https://novand-tech.com/card';
let qrSvgMarkup = '';
let qrPngDataUrl = '';
try {
  qrSvgMarkup = await QRCode.toString(canonicalCardUrl, {
    type: 'svg',
    margin: 1,
    color: {
      dark: '#0d1417',
      light: '#ffffff'
    }
  });
  qrPngDataUrl = await QRCode.toDataURL(canonicalCardUrl, {
    width: 800,
    margin: 2,
    color: {
      dark: '#0d1417',
      light: '#ffffff'
    }
  });
} catch (e) {
  qrSvgMarkup = '<svg viewBox="0 0 100 100"><rect width="100" height="100" fill="#0d1417"/></svg>';
  qrPngDataUrl = '';
}

const initialData = defaultLang === 'en' ? landingDataEn : landingDataFa;
const isEn = defaultLang === 'en';
---
<!doctype html>
<html lang={defaultLang} dir={isEn ? 'ltr' : 'rtl'} class={isEn ? '' : 'font-vazirmatn'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{isEn ? "Novand | Integrated Technology & Infrastructure Solutions — Connect" : "نُوَند | راهکارهای جامع فناوری و زیرساخت — کارت ویزیت و ارتباط"}</title>
    <meta name="description" content={isEn ? "Digital Connect & Business Card for Novand: Smart Homes, Enterprise Networking, VoIP, CCTV, and Systems." : "کارت ویزیت دیجیتال و راه‌های ارتباطی شرکت نُوَند: هوشمندسازی، شبکه‌های سازمانی، امنیت فیزیکی و سرورهای سازمانی."} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#ffffff" id="meta-theme-color" />
    <link rel="canonical" href={canonicalCardUrl} />

    <!-- Immediate Theme Initialization (Default = Light, Syncs with novand_theme) -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('novand_theme');
          var theme = stored === 'dark' ? 'dark' : 'light';
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Social & OpenGraph -->
    <meta property="og:title" content={isEn ? "Novand — Digital Connect & Business Card" : "Novand | نُوَند — Digital Connect & Business Card"} />
    <meta property="og:description" content={isEn ? "Integrated Technology & Infrastructure Solutions. Smart Homes, Networking, VoIP, CCTV, and Enterprise Servers." : "راهکارهای جامع فناوری و زیرساخت نُوَند. خانه هوشمند، شبکه‌های سازمانی، ویپ، نظارت تصویری و سرورها."} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalCardUrl} />
    <meta property="og:image" content="/branding/novand-social-banner-1200x630.png" />
    <meta property="og:site_name" content="Novand" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={isEn ? "Novand | Digital Connect & Business Card" : "نُوَند | کارت ارتباطی دیجیتال"} />
    <meta name="twitter:description" content={isEn ? "Direct channels, Telegram, Instagram, phone lines, and headquarters location for Novand Technology" : "راه‌های ارتباطی، اینستاگرام، تلگرام، تلفن‌ها و لوکیشن شرکت نُوَند"} />
    <meta name="twitter:image" content="/branding/novand-social-banner-1200x630.png" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data for LocalBusiness & Organization -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EngineeringCompany",
      "name": "Novand | نُوَند",
      "url": "https://novand-tech.com",
      "logo": "https://novand-tech.com/branding/novand-logo-square-dark.svg",
      "telephone": ["+989129321550", "+989196918758"],
      "email": "novand.info@gmail.com",
      "sameAs": [
        "https://instagram.com/novand_tech",
        "https://t.me/novand_tech",
        "https://t.me/+989196918758"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Unit 17, No. 26, West 24th St., South Allameh Tabatabaei St., Modiriat Blvd., Saadat Abad",
        "addressLocality": "Tehran",
        "addressCountry": "IR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 35.77618183390139,
        "longitude": 51.37842044504052
      }
    })} />
  </head>
  <body class="min-h-screen bg-stone-50 text-slate-900 dark:bg-[#0d1417] dark:text-[#f4f2f1] antialiased selection:bg-[#00d2b5]/30 transition-colors duration-200 relative overflow-x-hidden">
    
    <!-- Background Technical Texture & Glows -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute inset-0 bg-grid-subtle opacity-40 dark:opacity-20"></div>
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[550px] h-[350px] bg-gradient-to-b from-[#00d2b5]/15 via-[#10b981]/10 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute bottom-0 right-0 w-[400px] h-[300px] bg-[#00d2b5]/5 blur-3xl rounded-full"></div>
    </div>

    <!-- Main Mobile-First Ad & Digital Card Container -->
    <main class="relative z-10 w-full max-w-lg mx-auto px-4 py-6 sm:py-10 flex flex-col items-center">

      <!-- Top Utility Header (Theme & Lang & Share QR) -->
      <nav aria-label="Page Controls" class="w-full flex items-center justify-between gap-2 mb-6 px-1">
        <!-- Brand Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/80 dark:bg-[#151d21]/80 backdrop-blur-md border border-stone-200/90 dark:border-stone-800 text-xs shadow-xs">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span id="status-pill-text" class="font-medium text-stone-600 dark:text-stone-300 text-[11px] sm:text-xs">
            {initialData.statusText}
          </span>
        </div>

        <!-- Controls: Language, Theme, QR/Share -->
        <div class="flex items-center gap-1.5">
          <!-- Language Toggle Button -->
          <button
            id="lang-toggle-btn"
            type="button"
            class="h-9 px-3 rounded-full bg-white/90 dark:bg-[#151d21]/90 hover:bg-stone-100 dark:hover:bg-stone-800 border border-stone-200/90 dark:border-stone-800 text-xs font-semibold tracking-wide text-slate-700 dark:text-stone-200 shadow-xs transition-colors flex items-center gap-1 cursor-pointer focus-visible:outline-2"
            aria-label={initialData.ui.toggleLang}
            title={isEn ? "تغییر زبان به فارسی" : "Switch to English"}
          >
            <span id="lang-btn-text" class="font-bold text-xs uppercase">{isEn ? "فا" : "EN"}</span>
          </button>

          <!-- Theme Toggle Button -->
          <button
            id="card-theme-toggle"
            type="button"
            class="h-9 w-9 rounded-full bg-white/90 dark:bg-[#151d21]/90 hover:bg-stone-100 dark:hover:bg-stone-800 border border-stone-200/90 dark:border-stone-800 text-slate-700 dark:text-stone-200 shadow-xs transition-colors flex items-center justify-center cursor-pointer focus-visible:outline-2"
            aria-label={initialData.ui.toggleTheme}
            title={initialData.ui.toggleTheme}
          >
            <!-- Sun Icon for dark mode -->
            <svg id="theme-sun-icon" class="w-4 h-4 hidden dark:block text-amber-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <!-- Moon Icon for light mode -->
            <svg id="theme-moon-icon" class="w-4 h-4 block dark:hidden text-slate-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Share & QR Modal Trigger -->
          <button
            id="open-qr-btn"
            type="button"
            class="h-9 w-9 rounded-full bg-white/90 dark:bg-[#151d21]/90 hover:bg-stone-100 dark:hover:bg-stone-800 border border-stone-200/90 dark:border-stone-800 text-slate-700 dark:text-stone-200 shadow-xs transition-colors flex items-center justify-center cursor-pointer focus-visible:outline-2"
            aria-label={initialData.ui.qrModalTitle}
            title={initialData.ui.shareCard}
          >
            <svg class="w-4 h-4 text-[#008f7a] dark:text-[#00d2b5]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
          </button>
        </div>
      </nav>

      <!-- Profile & Brand Hero Header -->
      <section class="w-full text-center flex flex-col items-center mb-6 pt-2" aria-labelledby="card-brand-title">
        <!-- Logo Display with Interactive Circuit Ring -->
        <div class="relative mb-4 group cursor-pointer" id="logo-trigger">
          <div class="absolute -inset-2 bg-gradient-to-r from-[#00d2b5]/30 to-[#10b981]/30 rounded-3xl blur-md opacity-50 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative w-24 h-24 sm:w-28 sm:h-28 bg-white dark:bg-[#131d22] p-4 rounded-2xl border border-stone-200 dark:border-stone-800 shadow-lg flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
            <div class="w-full h-full text-slate-900 dark:text-[#f4f2f1]">
              <NovandLogo />
            </div>
          </div>
          <!-- Verified Shield Badge -->
          <div class="absolute -bottom-1 -right-1 bg-emerald-600 text-white rounded-full p-1.5 shadow-md border-2 border-white dark:border-[#0d1417]" title={initialData.ui.verifiedBusiness}>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>

        <!-- Company Identity -->
        <h1 id="card-brand-title" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center justify-center gap-2">
          <span id="profile-name">{initialData.name}</span>
          <span class="text-stone-300 dark:text-stone-700 font-light">|</span>
          <span id="profile-subname" class="font-sans font-bold text-xl sm:text-2xl text-[#008f7a] dark:text-[#00d2b5]">{isEn ? "Technology" : "Novand"}</span>
        </h1>

        <!-- Tagline & Core Positioning -->
        <p id="profile-tagline" class="text-xs sm:text-sm font-semibold tracking-wide text-stone-600 dark:text-stone-300 mt-1">
          {initialData.tagline}
        </p>

        <!-- Brief Bio -->
        <p id="profile-bio" class="text-xs text-stone-500 dark:text-stone-400 mt-2 max-w-sm leading-relaxed px-2">
          {initialData.bio}
        </p>
      </section>

      <!-- Primary Action Buttons (Call, WhatsApp, Email, Save vCard) -->
      <section class="w-full grid grid-cols-2 gap-2.5 mb-6" aria-label={initialData.ui.quickContact}>
        
        <!-- Direct Phone Call Action (Opens phone selector or primary line) -->
        <button
          type="button"
          id="btn-call-selector"
          class="flex items-center justify-center gap-2 py-3 px-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white dark:bg-[#10b981] dark:hover:bg-[#059669] dark:text-[#0d1417] font-semibold text-xs sm:text-sm shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span id="btn-call-text">{initialData.callButtonText}</span>
        </button>

        <!-- WhatsApp Quick Message Action -->
        <a
          id="whatsapp-link"
          href={initialData.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 py-3 px-3.5 rounded-xl bg-[#25D366] hover:bg-[#20ba59] text-white font-semibold text-xs sm:text-sm shadow-md transition-all duration-200 active:scale-[0.98]"
        >
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.983.535 1.777.78 2.796.78h.005c3.18 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.766-5.773-5.766zm3.376 8.21c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.12-.519-1.821-.755-3.003-2.6-3.094-2.723-.092-.123-.74-1.002-.74-1.921 0-.919.467-1.378.633-1.57.166-.192.365-.24.486-.24.121 0 .243.001.35.007.112.006.262-.042.41.314.152.365.518 1.261.564 1.353.046.092.077.201.015.323-.061.123-.092.199-.184.306-.092.107-.195.239-.278.322-.093.092-.19.192-.082.378.108.185.481.795 1.032 1.286.71.633 1.309.828 1.494.92.185.092.293.077.401-.046.108-.123.463-.538.587-.723.123-.184.247-.154.416-.092.17.062 1.077.508 1.262.6.185.092.308.138.354.215.046.077.046.447-.098.852z"></path>
          </svg>
          <span id="btn-whatsapp-text">{initialData.whatsappLabel}</span>
        </a>

        <!-- Corporate Email Action -->
        <a
          id="email-link"
          href={`mailto:${initialData.emailAddress}`}
          class="flex items-center justify-center gap-2 py-3 px-3.5 rounded-xl bg-white dark:bg-[#151d21] hover:bg-stone-100 dark:hover:bg-stone-800 text-slate-800 dark:text-stone-200 font-medium text-xs sm:text-sm border border-stone-200 dark:border-stone-800 shadow-xs transition-all duration-200 active:scale-[0.98]"
        >
          <svg class="w-4 h-4 shrink-0 text-[#008f7a] dark:text-[#00d2b5]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span id="btn-email-text">{initialData.emailLabel}</span>
        </a>

        <!-- Save Contact to Phone (vCard Download) -->
        <button
          type="button"
          id="btn-download-vcard"
          class="flex items-center justify-center gap-2 py-3 px-3.5 rounded-xl bg-white dark:bg-[#151d21] hover:bg-stone-100 dark:hover:bg-stone-800 text-slate-800 dark:text-stone-200 font-medium text-xs sm:text-sm border border-stone-200 dark:border-stone-800 shadow-xs transition-all duration-200 active:scale-[0.98] cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span id="btn-vcard-text">{initialData.vcardButtonText}</span>
        </button>

      </section>

      <!-- Expandable Phone Numbers Drawer (Instant Access & Copy) -->
      <section id="phone-numbers-drawer" class="w-full mb-6 bg-white dark:bg-[#151d21] border border-stone-200/90 dark:border-stone-800 rounded-2xl p-4 shadow-sm" aria-label={isEn ? "Direct Engineering Phone Numbers" : "خطوط تماس تلفنی مهندسی"}>
        <div class="flex items-center justify-between mb-3 border-b border-stone-100 dark:border-stone-800/80 pb-2">
          <span class="text-xs font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#008f7a] dark:text-[#00d2b5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
            <span id="drawer-phones-label">{isEn ? "Direct Engineering Lines" : "خطوط ارتباطی مستقیم"}</span>
          </span>
          <span id="hotline-badge" class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 rounded-md font-semibold">
            {initialData.ui.technicalHotline}
          </span>
        </div>

        <div class="space-y-2.5">
          <!-- Primary Line -->
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-stone-50 dark:bg-[#10171a] border border-stone-200/70 dark:border-stone-800/80">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="block text-[11px] text-stone-500 dark:text-stone-400" id="phone1-label">
                    {initialData.ui.primaryPhoneTitle}
                  </span>
                  <span class="text-[10px] font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-100/80 dark:bg-emerald-950/70 px-1.5 py-0.5 rounded-md" id="phone1-contact">
                    {initialData.phonePrimaryContact}
                  </span>
                </div>
                <span class="font-mono text-sm font-bold text-slate-900 dark:text-white block mt-0.5" id="phone1-number" dir="ltr">{initialData.phonePrimaryDisplay}</span>
              </div>
            </div>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                data-copy={initialData.phonePrimary}
                class="copy-btn p-2 rounded-lg bg-white dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-600 dark:text-stone-300 transition-colors cursor-pointer"
                title={initialData.ui.copyNumber}
                aria-label={initialData.ui.copyPrimaryPhone}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
              </button>
              <a
                id="call-btn-1"
                href={`tel:${initialData.phonePrimary}`}
                class="py-1.5 px-3 rounded-lg bg-slate-900 dark:bg-[#00d2b5] text-white dark:text-[#0d1417] text-xs font-semibold hover:opacity-90 transition-opacity"
              >
                {initialData.ui.callNow}
              </a>
            </div>
          </div>

          <!-- Secondary Line (+98 919 691 8758 with direct Telegram & Call) -->
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-stone-50 dark:bg-[#10171a] border border-stone-200/70 dark:border-stone-800/80">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-cyan-100 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="block text-[11px] text-stone-500 dark:text-stone-400" id="phone2-label">
                    {initialData.ui.secondaryPhoneTitle}
                  </span>
                  <span class="text-[10px] font-semibold text-cyan-700 dark:text-cyan-300 bg-cyan-100/80 dark:bg-cyan-950/70 px-1.5 py-0.5 rounded-md" id="phone2-contact">
                    {initialData.phoneSecondaryContact}
                  </span>
                </div>
