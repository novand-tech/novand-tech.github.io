---
const isEn = Astro.url.pathname.startsWith("/en");
const companyData = getCompanyData(Astro.url.pathname);
import Button from '../ui/Button.astro';
import { getCompanyData } from "../../data/company";
---
<section class="relative bg-[#141210] text-[#f4f2f1] overflow-hidden border-b border-[#15120e] pt-16 pb-20 sm:pt-24 sm:pb-32 bg-grid-subtle">
  
  <!-- Subtle geometric ambiance -->
  <div class="absolute inset-0 pointer-events-none opacity-30">
    <div class="w-[600px] h-[600px] border border-[#f4f2f1] rotate-45 opacity-5 absolute -top-48 -left-48"></div>
    <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-[#0d1417] rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center">
      
      <!-- Text Column (7 Cols) -->
      <div class="lg:col-span-7 space-y-6 lg:border-r lg:border-[#15120e] lg:pr-12">
        
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-3 text-[10px] uppercase font-mono tracking-[0.35em] text-[#f6f2ee] opacity-75">
          <span class="w-8 h-[1px] bg-[#f4f2f1] opacity-60"></span>
          <span>{isEn ? '01 // Architectural Engineering' : '01 // مهندسی معماری'}</span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light tracking-tight leading-[1.08] text-[#f4f2f1]">
          {companyData.headline}
        </h1>

        <!-- Copy -->
        <p class="text-base sm:text-lg text-[#f4f2f1] opacity-75 font-light leading-relaxed max-w-2xl">
          {companyData.heroCopy}
        </p>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-5">
          <Button href={isEn ? "/en/contact#consultation" : "/contact#consultation"} variant="primary" size="lg">
            {isEn ? 'Request Consultation' : 'درخواست مشاوره'}
          </Button>
          <Button href={isEn ? "/en/services" : "/services"} variant="outline" size="lg">
            {isEn ? 'Explore Services' : 'بررسی خدمات'}
          </Button>
          <a href={isEn ? "/en/projects" : "/projects"} class="inline-flex items-center gap-3 group px-2 py-3">
            <div class="w-10 h-[1px] bg-[#f4f2f1] group-hover:w-14 transition-all"></div>
            <span class="text-[10px] uppercase tracking-widest font-bold text-[#f4f2f1]">
              {isEn ? 'Portfolios →' : 'پورتفولیو ←'}
            </span>
          </a>
        </div>

        <!-- Technical Verification Metrics -->
        <div class="pt-8 border-t border-[#15120e] grid grid-cols-3 gap-6 text-left">
          <div>
            <span class="block text-2xl sm:text-3xl font-mono font-light text-[#f4f2f1]">100%</span>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#f4f2f1]/50 block mt-1">{isEn ? 'Deterministic Cabling' : 'کابل‌کشی پایدار'}</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-mono font-light text-[#f4f2f1]">{isEn ? 'Zero' : 'صفر'}</span>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#f4f2f1]/50 block mt-1">{isEn ? 'Cloud Lock-In' : 'وابستگی ابری'}</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-mono font-light text-[#f4f2f1]">{isEn ? 'Open' : 'باز'}</span>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#f4f2f1]/50 block mt-1">{isEn ? 'Standard Buses' : 'گذرگاه‌های استاندارد'}</span>
          </div>
        </div>

      </div>

      <!-- Architectural Imagery Column (5 Cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative bg-[#0d1417] border border-[#15120e] p-2 overflow-hidden shadow-2xl">
          
          <!-- Geometric background wireframes -->
          <div class="w-[400px] h-[400px] border border-[#f4f2f1] rotate-45 opacity-10 absolute pointer-events-none -top-16 -right-16"></div>
          <div class="w-[250px] h-[250px] border border-[#f4f2f1] rotate-12 opacity-5 absolute pointer-events-none -bottom-10 -left-10"></div>

          <!-- Image frame -->
          <div class="relative aspect-4/5 overflow-hidden bg-[#141210]">
            <img 
              src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&q=80" 
              alt="High-density enterprise fiber optic and server infrastructure enclosure" 
              class="w-full h-full object-cover grayscale contrast-125 brightness-90"
              loading="eager"
            />
            
            <!-- Technical Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0d1417] via-transparent to-[#0d1417]/30"></div>
            
            <!-- Coordinate HUD Overlay -->
            <div class="absolute top-4 left-4 text-[10px] font-mono text-[#f4f2f1] bg-[#0d1417]/90 px-2.5 py-1 border border-[#15120e] tracking-widest">
              {isEn ? 'PHYSICAL LAYER // RACK-01' : 'لایه فیزیکی // RACK-01'}
            </div>

            <div class="absolute bottom-4 left-4 right-4 bg-[#0d1417]/95 border border-[#15120e] p-4 text-xs font-mono text-[#f4f2f1] backdrop-blur-xs">
              <div class="flex items-center justify-between border-b border-[#15120e] pb-2 mb-2 text-[10px] uppercase tracking-[0.15em] text-[#f6f2ee]">
                <span>{isEn ? 'SPECIFICATION STANDARDS' : 'استانداردهای مشخصات'}</span>
                <span class="text-[9px] px-1.5 py-0.5 bg-[#15120e] border border-[#15120e]">{isEn ? 'STATUS: OPERATIONAL' : 'وضعیت: عملیاتی'}</span>
              </div>
              <p class="text-[11px] text-[#f4f2f1]/60 leading-snug font-sans font-light">
                TIA-568-D compliant Cat6A & single-mode fiber optical backbones with certified OTDR test verification.
              </p>
            </div>
          </div>

          <!-- Decorative corner brackets -->
          <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-[#f4f2f1]/40"></div>
          <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-[#f4f2f1]/40"></div>
          <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-[#f4f2f1]/40"></div>
          <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-[#f4f2f1]/40"></div>

        </div>
      </div>

    </div>
  </div>

</section>