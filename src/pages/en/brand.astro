---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NovandLogo from '@/components/ui/NovandLogo.astro';
---
<BaseLayout
  title="Brand & Identity System | Novand"
  description="The official brand identity, logomarks, typography, color tokens, and asset guidelines for Novand — integrated technology and engineering infrastructure."
>
  <!-- Sticky Quick Sub-Navigation for Brand System -->
  <div class="sticky top-20 z-40 bg-[#090e10]/90 backdrop-blur-md border-b border-[#15120e] hidden md:block">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-12 text-xs font-mono">
      <div class="flex items-center gap-6">
        <a href="#overview" class="text-[#f4f2f1]/70 hover:text-[#00d2b5] transition-colors uppercase tracking-wider">Overview</a>
        <a href="#anatomy" class="text-[#f4f2f1]/70 hover:text-[#00d2b5] transition-colors uppercase tracking-wider">Anatomy</a>
        <a href="#logos" class="text-[#f4f2f1]/70 hover:text-[#00d2b5] transition-colors uppercase tracking-wider">Logos &amp; Lockups</a>
        <a href="#colors" class="text-[#f4f2f1]/70 hover:text-[#00d2b5] transition-colors uppercase tracking-wider">Color Tokens</a>
        <a href="#typography" class="text-[#f4f2f1]/70 hover:text-[#00d2b5] transition-colors uppercase tracking-wider">Typography</a>
        <a href="#standards" class="text-[#f4f2f1]/70 hover:text-[#00d2b5] transition-colors uppercase tracking-wider">Rules &amp; Sizing</a>
      </div>
      <a 
        href="/branding/novand-brand-assets.zip" 
        download 
        class="inline-flex items-center gap-2 text-[#00d2b5] hover:text-[#10b981] font-semibold transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download Brand Pack (.ZIP 1.2 MB)
      </a>
    </div>
  </div>

  <!-- Hero Section -->
  <section id="overview" class="py-16 sm:py-24 bg-[#0d1417] text-[#f4f2f1] border-b border-[#15120e] relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#141b1f_1px,transparent_1px),linear-gradient(to_bottom,#141b1f_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Copy & Callouts -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#141b1f] border border-[#1a2327] text-xs font-mono tracking-widest uppercase text-[#f4f2f1]/80 rounded-sm">
            <span class="w-2 h-2 rounded-full bg-[#00d2b5] animate-pulse"></span>
            Design System · Brand Guidelines · Master Kit v2.4
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight font-sans">
            Architectural Precision.<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00d2b5] to-[#10b981]">
              Converged Digital Flow.
            </span>
          </h1>

          <p class="text-base sm:text-lg text-[#f4f2f1]/70 leading-relaxed font-light max-w-2xl">
            The Novand identity bridges the structural permanence of modern physical facilities with the dynamic flow of high-speed optical routing and intelligent automation. This official kit provides comprehensive standards, geometry specifications, color tokens, and multi-purpose logos for media, architectural blueprints, digital products, and physical hardware.
          </p>

          <!-- Action buttons -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a 
              href="/branding/novand-brand-assets.zip" 
              download
              class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-[#00d2b5] hover:bg-[#00e5c5] text-[#0d1417] font-semibold text-sm tracking-wide rounded-sm transition-all shadow-[0_0_20px_rgba(0,210,181,0.25)] hover:shadow-[0_0_30px_rgba(0,210,181,0.4)]"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download Complete Brand Kit (.ZIP)
            </a>

            <a 
              href="#logos" 
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1] font-medium text-sm tracking-wide border border-[#1a2327] rounded-sm transition-colors"
            >
              Explore Logo Assets
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Quick Metrics Bar -->
          <div class="pt-6 grid grid-cols-3 gap-4 border-t border-[#15120e] max-w-lg">
            <div>
              <div class="text-[10px] font-mono text-[#f4f2f1]/50 uppercase">Vector Mark</div>
              <div class="text-sm font-mono text-white font-semibold mt-0.5">W3C SVG 1.1</div>
            </div>
            <div>
              <div class="text-[10px] font-mono text-[#f4f2f1]/50 uppercase">Color Spectrum</div>
              <div class="text-sm font-mono text-[#00d2b5] font-semibold mt-0.5">Cyan-Emerald Bus</div>
            </div>
            <div>
              <div class="text-[10px] font-mono text-[#f4f2f1]/50 uppercase">Dual Language</div>
              <div class="text-sm font-mono text-white font-semibold mt-0.5">EN + FA Vazirmatn</div>
            </div>
          </div>
        </div>

        <!-- Right: Grand Emblem Showcase Canvas -->
        <div class="lg:col-span-5">
          <div class="bg-[#141b1f] border border-[#1a2327] p-8 sm:p-10 rounded-sm relative group overflow-hidden shadow-2xl">
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-[#00d2b5]/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <!-- Logo Stage -->
            <div class="aspect-square w-full max-w-[340px] mx-auto flex items-center justify-center p-8 bg-[#090e10] border border-[#15120e] rounded-sm relative">
              <!-- Background Circuit Guides -->
              <div class="absolute inset-0 bg-[radial-gradient(#1a2327_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>
              
              <div class="w-44 h-44 sm:w-56 sm:h-56 text-white relative z-10 transition-transform duration-500 group-hover:scale-105 drop-shadow-[0_12px_40px_rgba(0,210,181,0.18)]">
                <NovandLogo />
              </div>

              <!-- Live Coordinate Badge -->
              <div class="absolute bottom-2.5 left-2.5 px-2 py-0.5 bg-[#0d1417]/80 border border-[#1a2327] rounded text-[9px] font-mono text-[#00d2b5]">
                SCALE: 1:1 MASTER
              </div>
            </div>

            <!-- Signature Card Footer -->
            <div class="mt-6 flex items-center justify-between text-xs border-t border-[#15120e] pt-4">
              <div>
                <div class="font-bold text-white font-sans uppercase tracking-wider">Novand Monogram</div>
                <div class="text-[10px] font-mono text-[#f4f2f1]/60">Physical Infrastructure &amp; Dynamic Traces</div>
              </div>
              <a 
                href="/branding/novand-logo-vector.svg" 
                download="novand-logo-master.svg" 
                class="px-2.5 py-1 bg-[#090e10] hover:bg-[#00d2b5]/20 hover:text-[#00d2b5] border border-[#1a2327] text-[10px] font-mono rounded transition-colors text-[#f4f2f1]/80"
              >
                Download SVG
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: Anatomy & Geometric Construction -->
  <section id="anatomy" class="py-20 bg-[#090e10] text-[#f4f2f1] border-b border-[#15120e]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-14">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00d2b5] block mb-2">Geometric Blueprint</span>
        <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight">
          The Anatomy of the Monogram
        </h2>
        <p class="text-sm sm:text-base text-[#f4f2f1]/70 leading-relaxed font-light mt-2">
          Every vector line and node corresponds to an engineering discipline in Novand’s capability stack, calculated along precise 45-degree isometric conduits.
        </p>
      </div>

      <!-- Interactive Anatomy Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Exploded Schematic Visual -->
        <div class="lg:col-span-6 bg-[#0d1417] border border-[#1a2327] p-8 sm:p-12 rounded-sm relative">
          <div class="text-center mb-6">
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#f4f2f1]/40">CAD Vector Schematic · 1080×1080 Grid</span>
          </div>

          <div class="relative max-w-[340px] mx-auto aspect-square flex items-center justify-center p-6 bg-[#090e10] border border-[#15120e] rounded">
            <!-- Grid Lines -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-25" viewBox="0 0 100 100">
              <line x1="0" y1="50" x2="100" y2="50" stroke="#00d2b5" stroke-dasharray="2 2" stroke-width="0.5" />
              <line x1="50" y1="0" x2="50" y2="100" stroke="#00d2b5" stroke-dasharray="2 2" stroke-width="0.5" />
              <circle cx="50" cy="50" r="45" fill="none" stroke="#f4f2f1" stroke-dasharray="1 3" stroke-width="0.5" />
            </svg>

            <!-- Scaled Emblem with Callout markers -->
            <div class="w-56 h-56 text-white relative">
              <NovandLogo />

              <!-- Overlay Callout 1: Roofline -->
              <div class="absolute -top-2 left-6 bg-[#0d1417] border border-[#00d2b5] text-[#00d2b5] w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-mono font-bold shadow-lg">1</div>
              <!-- Overlay Callout 2: Windows -->
              <div class="absolute top-[42%] left-[48%] bg-[#0d1417] border border-[#00d2b5] text-[#00d2b5] w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-mono font-bold shadow-lg">2</div>
              <!-- Overlay Callout 3: Circuit Traces -->
              <div class="absolute bottom-8 left-12 bg-[#0d1417] border border-[#00d2b5] text-[#00d2b5] w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-mono font-bold shadow-lg">3</div>
              <!-- Overlay Callout 4: Terminal Nodes -->
              <div class="absolute top-1/2 right-0 bg-[#0d1417] border border-[#10b981] text-[#10b981] w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-mono font-bold shadow-lg">4</div>
            </div>
          </div>

          <div class="mt-6 flex justify-between text-[11px] font-mono text-[#f4f2f1]/50 border-t border-[#15120e] pt-4">
            <span>Primary Stroke: 5.0pt</span>
            <span>Trace Conduits: 4.5pt</span>
            <span>Terminals: 3.5pt / 4.5r</span>
          </div>
        </div>

        <!-- Right: Rationale Cards -->
        <div class="lg:col-span-6 space-y-4">
          
          <div class="p-5 bg-[#141b1f] border border-[#1a2327] rounded-sm hover:border-[#00d2b5]/40 transition-colors">
            <div class="flex items-start gap-4">
              <div class="w-7 h-7 rounded-sm bg-[#090e10] border border-[#00d2b5]/50 text-[#00d2b5] flex items-center justify-center text-xs font-mono font-bold shrink-0">
                1
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-sans">The Architectural Gable &amp; Envelope</h3>
                <p class="text-xs text-[#f4f2f1]/70 leading-relaxed font-light mt-1">
                  The bold white roofline establishes physical presence, facility permanence, and structural sheltering. It represents data center buildings, smart corporate offices, and campus infrastructure.
                </p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-[#141b1f] border border-[#1a2327] rounded-sm hover:border-[#00d2b5]/40 transition-colors">
            <div class="flex items-start gap-4">
              <div class="w-7 h-7 rounded-sm bg-[#090e10] border border-[#00d2b5]/50 text-[#00d2b5] flex items-center justify-center text-xs font-mono font-bold shrink-0">
                2
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-sans">The Quad Window Array</h3>
                <p class="text-xs text-[#f4f2f1]/70 leading-relaxed font-light mt-1">
                  A calibrated 2×2 grid signifying structured spaces, server rack chassis, and organizational discipline. It anchors the mark to real-world corporate architecture and workspace operations.
                </p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-[#141b1f] border border-[#1a2327] rounded-sm hover:border-[#00d2b5]/40 transition-colors">
            <div class="flex items-start gap-4">
              <div class="w-7 h-7 rounded-sm bg-[#090e10] border border-[#00d2b5]/50 text-[#00d2b5] flex items-center justify-center text-xs font-mono font-bold shrink-0">
                3
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-sans">45° Converged Circuit Traces</h3>
                <p class="text-xs text-[#f4f2f1]/70 leading-relaxed font-light mt-1">
                  Stepped diagonal pathways symbolize FTTH fiber optic trunk lines, high-frequency copper cabling, and active routing conduits carrying multi-gigabit traffic across the facility.
                </p>
              </div>
            </div>
          </div>

          <div class="p-5 bg-[#141b1f] border border-[#1a2327] rounded-sm hover:border-[#10b981]/40 transition-colors">
            <div class="flex items-start gap-4">
              <div class="w-7 h-7 rounded-sm bg-[#090e10] border border-[#10b981]/50 text-[#10b981] flex items-center justify-center text-xs font-mono font-bold shrink-0">
                4
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-sans">Terminal Node Endpoints</h3>
                <p class="text-xs text-[#f4f2f1]/70 leading-relaxed font-light mt-1">
                  Three distinct circular endpoints embody connected clients: IoT building automation sensors, CCTV &amp; security access controllers, and high-performance server clusters.
                </p>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Section: Extended Multi-Purpose Logo Collection -->
  <section id="logos" class="py-20 bg-[#0d1417] text-[#f4f2f1] border-b border-[#15120e]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div class="max-w-2xl">
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#00d2b5] block mb-2">Asset Matrix</span>
          <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight">
            Logomarks &amp; Extended Lockups
          </h2>
          <p class="text-sm sm:text-base text-[#f4f2f1]/70 leading-relaxed font-light mt-2">
            Calibrated logo formats for every physical and digital surface — from web navigation and software interfaces to physical metal chassis laser engraving and printed contracts.
          </p>
        </div>

        <!-- Filter Buttons -->
        <div class="flex flex-wrap gap-2 text-xs font-mono" id="logo-filter-bar">
          <button 
            type="button" 
            data-filter="all" 
            class="filter-btn px-3 py-1.5 bg-[#00d2b5] text-[#0d1417] font-bold rounded-sm cursor-pointer transition-all"
          >
            All Formats
          </button>
          <button 
            type="button" 
            data-filter="lockup" 
            class="filter-btn px-3 py-1.5 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1]/80 rounded-sm border border-[#1a2327] cursor-pointer transition-all"
          >
            Wordmarks &amp; Lockups
          </button>
          <button 
            type="button" 
            data-filter="badge" 
            class="filter-btn px-3 py-1.5 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1]/80 rounded-sm border border-[#1a2327] cursor-pointer transition-all"
          >
            Monomarks &amp; Badges
          </button>
          <button 
            type="button" 
            data-filter="mono" 
            class="filter-btn px-3 py-1.5 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1]/80 rounded-sm border border-[#1a2327] cursor-pointer transition-all"
          >
            Monochrome &amp; Print
          </button>
          <button 
            type="button" 
            data-filter="social" 
            class="filter-btn px-3 py-1.5 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1]/80 rounded-sm border border-[#1a2327] cursor-pointer transition-all"
          >
            Social &amp; Media
          </button>
          <button 
            type="button" 
            data-filter="persian" 
            class="filter-btn px-3 py-1.5 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1]/80 rounded-sm border border-[#1a2327] cursor-pointer transition-all"
          >
            Persian Version
          </button>
        </div>
      </div>

      <!-- Assets Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="assets-container">

        <!-- Asset 1: Horizontal Lockup (Dark) -->
        <div class="asset-card group bg-[#141b1f] border border-[#1a2327] rounded-sm overflow-hidden flex flex-col justify-between" data-category="lockup">
          <div>
            <!-- Preview Stage (Dark) -->
            <div class="h-52 bg-[#090e10] p-6 flex items-center justify-center border-b border-[#15120e] relative">
              <img 
                src="/branding/novand-logo-horizontal-dark.svg" 
                alt="Novand Horizontal Logo Dark" 
                class="max-h-24 max-w-[85%] object-contain transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute top-2.5 right-2.5 px-2 py-0.5 bg-[#0d1417] text-[10px] font-mono text-[#00d2b5] border border-[#1a2327] rounded">
                Dark Mode
              </span>
            </div>
            <!-- Meta Details -->
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-bold text-white font-sans uppercase">Horizontal Lockup · Dark</h3>
                <span class="text-[10px] font-mono text-[#f4f2f1]/50">1000×280</span>
              </div>
              <p class="text-xs text-[#f4f2f1]/70 leading-relaxed font-light mb-4">
                Primary corporate identity for website headers, software dashboards, dark pitch decks, and partner presentation footers.
              </p>
              <div class="flex items-center gap-2 text-[10px] font-mono text-[#00d2b5]">
                <span>Vector SVG</span> • <span>Lossless PNG</span>
              </div>
            </div>
          </div>
          <!-- Download Actions -->
          <div class="p-4 bg-[#0d1417] border-t border-[#15120e] flex items-center gap-2">
            <a 
              href="/branding/novand-logo-horizontal-dark.svg" 
              download 
              class="flex-1 text-center py-2 bg-[#141b1f] hover:bg-[#00d2b5] hover:text-[#0d1417] text-[#f4f2f1] text-xs font-mono font-medium rounded-sm border border-[#1a2327] transition-all"
            >
              SVG (Vector)
            </a>
            <a 
              href="/branding/novand-logo-horizontal-dark.png" 
              download 
              class="flex-1 text-center py-2 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1]/80 hover:text-white text-xs font-mono font-medium rounded-sm border border-[#1a2327] transition-all"
            >
              PNG (Raster)
            </a>
          </div>
        </div>

        <!-- Asset 2: Horizontal Lockup (Light) -->
        <div class="asset-card group bg-[#141b1f] border border-[#1a2327] rounded-sm overflow-hidden flex flex-col justify-between" data-category="lockup">
          <div>
            <!-- Preview Stage (Light Canvas) -->
            <div class="h-52 bg-[#f8fafc] p-6 flex items-center justify-center border-b border-[#e2e8f0] relative">
              <img 
                src="/branding/novand-logo-horizontal-light.svg" 
                alt="Novand Horizontal Logo Light" 
                class="max-h-24 max-w-[85%] object-contain transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute top-2.5 right-2.5 px-2 py-0.5 bg-white text-[10px] font-mono text-[#008f7a] border border-[#cbd5e1] rounded">
                Light Mode
              </span>
            </div>
            <!-- Meta Details -->
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-bold text-white font-sans uppercase">Horizontal Lockup · Light</h3>
                <span class="text-[10px] font-mono text-[#f4f2f1]/50">1000×280</span>
              </div>
              <p class="text-xs text-[#f4f2f1]/70 leading-relaxed font-light mb-4">
                Engineered for white backgrounds, paper invoices, engineering proposals, client contracts, and light-mode slide decks.
              </p>
              <div class="flex items-center gap-2 text-[10px] font-mono text-[#00d2b5]">
                <span>Vector SVG</span> • <span>Lossless PNG</span>
              </div>
            </div>
          </div>
          <!-- Download Actions -->
          <div class="p-4 bg-[#0d1417] border-t border-[#15120e] flex items-center gap-2">
            <a 
              href="/branding/novand-logo-horizontal-light.svg" 
              download 
              class="flex-1 text-center py-2 bg-[#141b1f] hover:bg-[#00d2b5] hover:text-[#0d1417] text-[#f4f2f1] text-xs font-mono font-medium rounded-sm border border-[#1a2327] transition-all"
            >
              SVG (Vector)
            </a>
            <a 
              href="/branding/novand-logo-horizontal-light.png" 
              download 
              class="flex-1 text-center py-2 bg-[#141b1f] hover:bg-[#1a2327] text-[#f4f2f1]/80 hover:text-white text-xs font-mono font-medium rounded-sm border border-[#1a2327] transition-all"
            >
              PNG (Raster)
            </a>
          </div>
        </div>

        <!-- Asset 3: Horizontal Lockup (Persian) -->
        <div class="asset-card group bg-[#141b1f] border border-[#1a2327] rounded-sm overflow-hidden flex flex-col justify-between" data-category="lockup persian">
          <div>
            <!-- Preview Stage -->
            <div class="h-52 bg-[#090e10] p-6 flex items-center justify-center border-b border-[#15120e] relative">
              <img 
                src="/branding/novand-logo-horizontal-persian.svg" 
                alt="Novand Horizontal Persian Logo" 
                class="max-h-24 max-w-[90%] object-contain transition-transform duration-300 group-hover:scale-105"
