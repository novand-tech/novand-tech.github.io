---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'warm';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  id,
  target,
  rel,
  ...rest
} = Astro.props;

const baseStyles = "btn-novand inline-flex items-center justify-center font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:pointer-events-none text-center select-none cursor-pointer";

const sizeStyles = {
  sm: "text-[10px] px-4 py-2 uppercase font-bold tracking-widest",
  md: "text-[11px] px-6 py-2.5 uppercase font-bold tracking-widest",
  lg: "text-[11px] sm:text-xs px-8 py-3.5 uppercase font-bold tracking-widest"
};

const variantStyles = {
  primary: "btn-novand-primary bg-[#0f172a] text-[#ffffff] hover:bg-[#1e293b] active:bg-[#334155] dark:bg-[#f4f2f1] dark:text-[#141210] dark:hover:bg-[#ffffff] border border-transparent shadow-xs keep-white",
  secondary: "btn-novand-secondary bg-[#ffffff] text-[#0f172a] hover:bg-[#f8fafc] border border-[#cbd5e1] dark:bg-[#15120e] dark:text-[#f4f2f1] dark:hover:bg-[#1a2327] dark:border-[#15120e] active:bg-[#f1f5f9]",
  outline: "btn-novand-outline bg-transparent text-[#0f172a] border border-[#0f172a] hover:bg-[#0f172a] hover:text-[#ffffff] dark:text-[#f4f2f1] dark:border-[#f4f2f1]/40 dark:hover:border-[#f4f2f1] dark:hover:text-[#ffffff] dark:hover:bg-white/10",
  ghost: "btn-novand-ghost bg-transparent text-[#0f172a]/80 hover:text-[#008f7a] hover:bg-slate-200/50 dark:text-[#f4f2f1]/80 dark:hover:text-[#f4f2f1] dark:hover:bg-white/5",
  warm: "btn-novand-warm bg-[#e2e8f0] text-[#0f172a] hover:bg-[#cbd5e1] border border-[#cbd5e1] dark:bg-[#15120e] dark:text-[#f4f2f1] dark:hover:bg-[#1a2327] dark:border-[#15120e]"
};

const computedClass = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---
{
  href ? (
    <a href={href} class={computedClass} id={id} target={target} rel={rel} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={computedClass} id={id} {...rest}>
      <slot />
    </button>
  )
}