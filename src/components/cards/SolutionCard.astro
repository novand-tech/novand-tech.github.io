---
import type { SolutionDetail } from '../../data/solutions';

interface Props {
  solution: SolutionDetail;
  theme?: 'dark' | 'light';
}

const { solution } = Astro.props;
const isEn = Astro.url.pathname.startsWith("/en");

const solutionIconMap: Record<string, string> = {
  "residential": "/icons/smart-home.svg",
  "business": "/icons/network-core.svg",
  "education": "/icons/datacenter-rack.svg",
  "healthcare-hospitality": "/icons/critical-power.svg",
  "specialized-facilities": "/icons/iot-telemetry.svg"
};
const iconSrc = solutionIconMap[solution.slug] || '/icons/smart-home.svg';

const cardBg = 'bg-[#15120e] border-[#15120e] text-[#f4f2f1] hover:border-[#f4f2f1]/30';
const titleColor = 'text-[#f4f2f1] group-hover:text-[#00d2b5] transition-colors';
const descColor = 'text-[#f4f2f1]/65 font-light';
const dividerColor = 'border-[#15120e]';
const eyebrowColor = 'text-[#00d2b5] font-semibold';
---
<article class={`group relative border transition-all duration-300 flex flex-col justify-between p-6 sm:p-8 ${cardBg}`}>
  <div>
    <!-- Eyebrow with Domain Icon -->
    <div class={`flex items-center justify-between border-b ${dividerColor} pb-3 mb-4`}>
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-xs bg-[#0d1417] border border-[#1a2327] p-1 flex items-center justify-center group-hover:border-[#00d2b5]/50 transition-colors shrink-0">
          <img src={iconSrc} alt="" class="w-4 h-4 object-contain" />
        </div>
        <span class={`text-[10px] font-mono uppercase tracking-[0.2em] ${eyebrowColor}`}>
          {solution.eyebrow}
        </span>
      </div>
      <span class="text-[10px] font-mono opacity-40 text-[#f4f2f1] group-hover:text-[#f4f2f1] transition-colors">{isEn ? "ENV // ARCH" : "محیط // معماری"}</span>
    </div>

    <!-- Title -->
    <h3 class={`text-xl font-light tracking-tight mb-3 ${titleColor}`}>
      <a href={isEn ? `/en/solutions/${solution.slug}` : `/solutions/${solution.slug}`} class="focus-visible:outline-none focus-visible:underline">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {solution.title}
      </a>
    </h3>

    <!-- Summary -->
    <p class={`text-xs sm:text-sm leading-relaxed mb-6 ${descColor}`}>
      {solution.summary}
    </p>

    <!-- Core Pillars Preview -->
    <div class={`space-y-3 pt-4 border-t ${dividerColor} mb-6`}>
      {(solution.corePillars || []).slice(0, 2).map((pillar) => (
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider font-mono text-[#f4f2f1]/90 group-hover:text-[#00d2b5] transition-colors mb-1">
            {pillar.title}
          </h4>
          <p class={`text-xs line-clamp-2 leading-relaxed ${descColor}`}>
            {pillar.description}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer Indicator -->
  <div class={`pt-4 border-t ${dividerColor} flex items-center justify-between text-[10px] font-mono uppercase tracking-widest text-[#f4f2f1]/50 group-hover:text-[#00d2b5] transition-colors`}>
    <span class="tracking-wider">{isEn ? "Explore Environment" : "بررسی این محیط"}</span>
    <span class="text-[#00d2b5] group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
  </div>
</article>